---
import { getCollection } from 'astro:content';

// 🔥 自动获取 changelog 最新日期
const allChangelogs = await getCollection('changelog');
const latestChangelog = allChangelogs
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))[0];
const latestDate = latestChangelog ? latestChangelog.data.date : '2026-04-10';
---

<nav class="nav">
  <div class="nav-logo">康予纳安</div>
  <div class="nav-links">
    <a href="/explore">到处看看</a>
    <a href="/camellya" class="nav-accent">CamEllya</a>
    
    <a href="/changelog" id="updates-link" class="nav-updates">
      更新日志
      <span id="new-badge" class="new-badge" data-last-date={latestDate}>NEW</span>
    </a>
    
    <a href="/about">关于我</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-center">
    <div class="hero-badges">
      <span class="badge badge-blue">创作者</span>
      <span class="badge badge-blue">画师</span>
      <span class="badge badge-red">乐手</span>
    </div>
    <h1 class="hero-name">你好，我是<span>康纳</span> ✦</h1>
    <p class="hero-intro">欢迎来到我的网站！我是康纳，是一名创作者，我的网站里有许多关于我的事情，可以在网站的各个区里到处看看，希望对你有所帮助！我会不断更新的哦</p>
    <div class="hero-btns">
      <a href="/explore" class="btn-primary">到处看看 →</a>
      <a href="/about" class="btn-secondary">关于我</a>
      <a href="/camellya" class="btn-red">CamEllya 专区 ↗</a>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="section-hd">
    <span class="section-label">CamEllya 专区</span>
    <a href="/camellya" class="section-more">进入专区 →</a>
  </div>
  <div class="camellya-block">
    <div class="cam-header">
      <div>
        <div class="cam-title">CamEllya</div>
        <div class="cam-sub">世界观 · 角色 · 漫画</div>
      </div>
      <span class="cam-badge">副主页</span>
    </div>
    <div class="cam-grid">
      <a href="/camellya#characters" class="cam-cell">
        <div class="cam-cname">角色</div>
        <div class="cam-cdesc">络雪 · 百部 · 晴舒 · 日出，四人介绍与设定</div>
      </a>
      <a href="/camellya#world" class="cam-cell">
        <div class="cam-cname">世界观</div>
        <div class="cam-cdesc">CamEllya 的背景设定与世界架构</div>
      </a>
      <a href="/camellya#comics" class="cam-cell">
        <div class="cam-cname">漫画</div>
        <div class="cam-cdesc">故事连载、短篇与番外更新</div>
      </a>
    </div>
  </div>
</section>

<div class="tags-strip">
  <div class="tags">
    <span class="atag">画画</span>
    <span class="atag">写字</span>
    <span class="atag">玩音乐</span>
    <span class="atag">键盘手</span>
    <span class="atag atag-red">CamEllya</span>
  </div>
  <a href="/about" class="section-more">了解更多关于我 →</a>
</div>

<footer class="footer">
  <span>© 2026 康予纳安</span>
  <span class="footer-dot">持续更新中 ✦</span>
</footer>

<style>
:root {
  --bg: #F2F4F6;
  --surface: #ffffff;
  --blue: #4AACDB;
  --blue-light: #E8F5FC;
  --blue-border: #B8DCF0;
  --red: #C94040;
  --red-light: #FDECEC;
  --red-border: #f0bfbf;
  --text: #1a1a1a;
  --muted: #666666;
  --hint: #aaaaaa;
  --border: #e0e4ea;
}

/* ==================== 导航栏 ==================== */
.nav {
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 0.5px solid var(--border);
  flex-wrap: wrap;
  gap: 10px;
}
.nav-logo { font-size: 15px; font-weight: 500; color: var(--text); }
.nav-links { 
  display: flex; 
  gap: 14px; 
  flex-wrap: wrap; 
  justify-content: center;
}
.nav-links a { 
  font-size: 13px; 
  color: var(--muted); 
  text-decoration: none; 
  white-space: nowrap;
}
.nav-links a:hover { color: var(--blue); }
.nav-accent { color: var(--red) !important; font-weight: 500; }

.nav-updates { position: relative; color: var(--muted); text-decoration: none; font-size: 13px; padding-right: 4px; }
.nav-updates:hover { color: var(--blue); }

.new-badge {
  position: absolute;
  top: -6px;
  right: -11px;
  background: var(--red);
  color: white;
  font-size: 9px;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 20px;
  box-shadow: 0 2px 6px rgba(201, 64, 64, 0.4);
  animation: badge-pulse 2s infinite;
  display: none;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

/* ==================== Hero 区域 ==================== */
.hero {
  background-image: url('/images/hero-bg.png');
  background-size: cover;
  background-position: center 30%;
  position: relative;
  padding: 70px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 0.5px solid var(--border);
  min-height: 380px;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.68);
  z-index: 0;
}
.hero-center {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 580px;
  width: 100%;
}
.hero-badges { display: flex; gap: 6px; margin-bottom: 16px; justify-content: center; flex-wrap: wrap; }
.badge { font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; }
.badge-blue { background: var(--blue-light); color: #1A7FAD; }
.badge-red { background: var(--red-light); color: var(--red); }

.hero-name { 
  font-size: 28px; 
  font-weight: 500; 
  line-height: 1.3; 
  margin-bottom: 14px; 
  color: var(--text); 
}
.hero-name span { color: var(--blue); }

.hero-intro { 
  font-size: 14.5px; 
  color: var(--muted); 
  line-height: 1.8; 
  margin-bottom: 26px; 
}

.hero-btns { 
  display: flex; 
  gap: 10px; 
  flex-wrap: wrap; 
  justify-content: center; 
}

/* ==================== CamEllya 专区 ==================== */
.content-section { padding: 32px 20px; border-bottom: 0.5px solid var(--border); }
.section-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
.camellya-block { 
  background: var(--surface); 
  border-radius: 12px; 
  border: 0.5px solid var(--border); 
  overflow: hidden; 
}
.cam-header { 
  background: var(--blue-light); 
  padding: 16px 20px; 
  border-bottom: 0.5px solid var(--blue-border); 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
}
.cam-grid { 
  display: grid; 
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); 
  gap: 12px; 
  padding: 20px; 
}
.cam-cell { 
  padding: 18px; 
  border: 0.5px solid var(--border); 
  border-radius: 12px; 
  background: white; 
  transition: all 0.2s; 
}
.cam-cell:hover { background: #F8FBFE; border-color: var(--blue); }

/* ==================== Tags & Footer ==================== */
.tags-strip { 
  padding: 20px; 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  flex-wrap: wrap; 
  gap: 12px; 
}
.tags { display: flex; gap: 8px; flex-wrap: wrap; }

.footer { 
  background: var(--surface); 
  padding: 16px 20px; 
  border-top: 0.5px solid var(--border); 
  display: flex; 
  justify-content: space-between; 
  font-size: 12px; 
  color: var(--hint); 
  flex-wrap: wrap; 
  gap: 8px; 
}

/* ==================== 手机端重点优化 ==================== */
@media (max-width: 768px) {
  .nav { padding: 12px 16px; gap: 8px; }
  .nav-links { gap: 12px; }
  .nav-links a { font-size: 12.8px; }

  .hero { padding: 55px 16px; min-height: 340px; }
  .hero-name { font-size: 24px; }
  .hero-intro { font-size: 14px; }
  .hero-btns { gap: 8px; }

  .btn-primary, .btn-secondary, .btn-red { 
    font-size: 13px; 
    padding: 9px 18px; 
  }

  .content-section { padding: 24px 16px; }
  .cam-grid { grid-template-columns: 1fr; gap: 14px; }
  
  .tags-strip { flex-direction: column; align-items: flex-start; padding: 16px; }
  
  .footer { 
    padding: 14px 16px; 
    justify-content: center; 
    text-align: center; 
  }

  .new-badge { top: -4px; right: -8px; font-size: 8px; padding: 1px 5px; }
}
</style>

<script>
  const badge = document.getElementById('new-badge');
  const link = document.getElementById('updates-link');
  const lastUpdateDate = badge ? badge.dataset.lastDate : '2026-04-10';
  const lastSeen = localStorage.getItem('lastSeenChangelog');

  if (badge && (!lastSeen || lastSeen < lastUpdateDate)) {
    badge.style.display = 'inline';
  }
  if (link) {
    link.addEventListener('click', () => {
      localStorage.setItem('lastSeenChangelog', lastUpdateDate);
      if (badge) badge.style.display = 'none';
    });
  }
</script>