---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('gallery'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<BaseLayout title="画集 · 康予纳安">
  <nav class="nav">
    <a href="/" class="nav-logo">康予纳安</a>
    <div class="nav-links">
      <a href="/vlog">视频日记</a>
      <a href="/writing">文章</a>
      <a href="/gallery" class="nav-active">画集</a>
      <a href="/camellya" class="nav-accent">CamEllya</a>
      <a href="/about">关于我</a>
    </div>
  </nav>

  <main class="page-main">
    <header class="page-header">
      <div class="page-meta-tag">VISUAL_ARCHIVE // GALLERY</div>
      <h1 class="page-title">画集<span>.</span></h1>
    </header>

    <div class="masonry">
      {posts.map(post => (
        <a href={`/gallery/${post.id}`} class="masonry-item">
          <div class="image-wrapper">
            <img src={post.data.image} alt={post.data.title} loading="lazy" />
          </div>
          <div class="overlay">
            <div class="overlay-corner-decor"></div>
            <div class="overlay-content">
              <div class="overlay-title">{post.data.title}</div>
              <div class="overlay-date">{post.data.date}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <footer class="footer">
    <span>© 2026 康予纳安</span>
    <span class="footer-status">CORE_UPDATE: SUCCESS ✦</span>
  </footer>
</BaseLayout>

<style>
/* ── 导航栏：全面接入主页的暗色半透明毛玻璃质感 ── */
.nav { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 18px 32px; 
  border-bottom: 1px solid var(--border);
  background: rgba(13, 16, 32, 0.75);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-logo { 
  font-family: var(--font-mono);
  font-size: 16px; 
  font-weight: 600; 
  color: var(--text); 
  text-decoration: none;
  letter-spacing: 0.08em;
}
.nav-links { 
  display: flex; 
  gap: 24px; 
}
.nav-links a { 
  font-size: 14px; 
  color: var(--muted); 
  text-decoration: none;
  transition: color 0.2s ease, text-shadow 0.2s ease;
}
.nav-links a:hover { 
  color: var(--cyan); 
  text-shadow: 0 0 8px rgba(77, 223, 255, 0.5);
}
.nav-active { 
  color: var(--purple) !important; 
  font-weight: 600;
  text-shadow: 0 0 8px rgba(123, 94, 255, 0.4);
}
.nav-accent { 
  color: var(--red) !important; 
  font-weight: 600; 
}

/* ── 页面头部：融入主页的科技感 HUD 引导小字 ── */
.page-main { 
  max-width: 1200px; 
  margin: 0 auto; 
  padding: 50px 32px 80px; 
}
.page-header {
  margin-bottom: 40px;
}
.page-meta-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--cyan);
  letter-spacing: 0.18em;
  margin-bottom: 6px;
  opacity: 0.8;
}
.page-title { 
  font-size: 36px; 
  font-weight: 800; 
  color: var(--text); 
  letter-spacing: -0.5px;
}
.page-title span {
  color: var(--purple);
  text-shadow: 0 0 10px var(--purple);
}

/* ── 瀑布流网格 ── */
.masonry {
  columns: 4;
  column-gap: 18px;
}

@media(max-width: 968px) { .masonry { columns: 3; } }
@media(max-width: 768px) { 
  .masonry { columns: 2; column-gap: 12px; } 
  .page-main { padding: 30px 16px 60px; } 
  .nav { padding: 16px; } 
}

/* ── 画集卡片：完美继承主页的次级表面色与青色霓虹发光边框 ── */
.masonry-item {
  display: block;
  break-inside: avoid;
  margin-bottom: 18px;
  border-radius: 14px;
  overflow: hidden;
  position: relative;
  background: var(--surface-2); 
  border: 1px solid var(--border);
  text-decoration: none;
  cursor: pointer;
  transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
              box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.image-wrapper {
  width: 100%;
  height: auto;
  overflow: hidden;
  background: rgba(8, 11, 20, 0.5);
}

.masonry-item img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  filter: brightness(0.92);
}

/* 悬浮瞬间：边框变青色、触发主页标志性的霓虹微光、卡片极轻微利落上浮 */
.masonry-item:hover {
  border-color: var(--cyan);
  box-shadow: 0 0 25px rgba(77, 223, 255, 0.18);
  transform: translateY(-4px);
}

.masonry-item:hover img {
  transform: scale(1.02);
  filter: brightness(1.02);
}

/* ── 遮罩层：赛博风透明 HUD 窗格设计 ── */
.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(8, 11, 20, 0.92) 0%, rgba(8, 11, 20, 0.3) 60%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20px 16px;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.masonry-item:hover .overlay {
  opacity: 1;
}

/* 遮罩内部的赛博科技感小角标，呼应主页的 loader 直角定位线 */
.overlay-corner-decor {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 8px;
  height: 8px;
  border-top: 1.5px solid var(--cyan);
  border-right: 1.5px solid var(--cyan);
  opacity: 0.7;
}

.overlay-content {
  position: relative;
  z-index: 2;
}

.overlay-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 5px;
  letter-spacing: 0.02em;
}

/* 日期文本完全同步主页同款等宽高亮字体 */
.overlay-date {
  font-family: var(--font-mono); 
  font-size: 11px;
  color: var(--cyan);
  letter-spacing: 0.08em;
  text-shadow: 0 0 4px rgba(77, 223, 255, 0.3);
}

/* ── 页脚 ── */
.footer { 
  padding: 24px 32px; 
  border-top: 1px solid var(--border); 
  display: flex; 
  justify-content: space-between; 
  font-size: 13px; 
  color: var(--hint); 
  margin-top: 60px;
  background: transparent;
}
.footer-status { 
  font-family: var(--font-mono);
  color: var(--purple); 
  font-size: 11px;
  letter-spacing: 0.05em;
}
</style>