---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('gallery');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} · 康予纳安`}>
  <nav class="nav">
    <a href="/" class="nav-logo">康予纳安</a>
    <div class="nav-links">
      <a href="/vlog">视频日记</a>
      <a href="/writing">文章</a>
      <a href="/gallery" class="nav-active">画集</a>
      <a href="/camellya" class="nav-accent">CamEllya</a>
      <a href="/about">关于我</a>
    </div>
  </nav>

  <main class="post-main">
    <a href="/gallery" class="back">← 返回画集</a>
    <h1 class="post-title">{post.data.title}</h1>
    <div class="post-date">{post.data.date}</div>
    {post.data.image && (
      <div class="img-wrap">
        <img src={post.data.image} alt={post.data.title} class="post-img" />
      </div>
    )}
    {post.data.description && (
      <div class="post-desc">{post.data.description}</div>
    )}
    <div class="post-body"><Content /></div>
  </main>

  <footer class="footer">
    <span>© 2026 康予纳安</span>
    <span class="footer-dot">持续更新中 ✦</span>
  </footer>
</BaseLayout>

<style>
:root {
  --bg: #F2F4F6;
  --surface: #ffffff;
  --blue: #4AACDB;
  --blue-light: #E8F5FC;
  --blue-border: #B8DCF0;
  --red: #C94040;
  --red-light: #FDECEC;
  --red-border: #f0bfbf;
  --text: #1a1a1a;
  --muted: #666666;
  --hint: #aaaaaa;
  --border: #e0e4ea;
}

.nav { background: var(--surface); display: flex; align-items: center; justify-content: space-between; padding: 14px 32px; border-bottom: 0.5px solid var(--border); }
.nav-logo { font-size: 15px; font-weight: 500; color: var(--text); text-decoration: none; }
.nav-links { display: flex; gap: 22px; }
.nav-links a { font-size: 13px; color: var(--muted); text-decoration: none; }
.nav-links a:hover { color: var(--blue); }
.nav-active { color: var(--blue) !important; font-weight: 500; }
.nav-accent { color: var(--red) !important; font-weight: 500; }

.post-main { max-width: 900px; margin: 0 auto; padding: 40px 32px; }
.back { font-size: 13px; color: var(--blue); display: inline-block; margin-bottom: 20px; text-decoration: none; }
.post-title { font-size: 26px; font-weight: 500; color: var(--text); margin-bottom: 8px; }
.post-date { font-size: 13px; color: var(--hint); margin-bottom: 24px; }
.img-wrap { width: 100%; border-radius: 14px; overflow: hidden; margin-bottom: 20px; background: var(--bg); }
.post-img { width: 100%; height: auto; display: block; }
.post-desc { font-size: 14px; color: var(--muted); line-height: 1.8; margin-bottom: 20px; padding: 16px; background: var(--bg); border-radius: 10px; }
.post-body { font-size: 15px; color: var(--muted); line-height: 1.9; }

.footer { background: var(--surface); padding: 14px 32px; border-top: 0.5px solid var(--border); display: flex; justify-content: space-between; font-size: 12px; color: var(--hint); margin-top: 40px; }
.footer-dot { color: var(--blue); }
</style>