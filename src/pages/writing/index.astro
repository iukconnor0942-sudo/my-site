---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// 1. 获取 writing 集合中的所有文章
const allPosts = await getCollection('writing');
// 2. 按日期倒序排列，让最新的文章排在最前面
allPosts.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
---

<BaseLayout title="藏书阁 · 康予纳安">
  <main class="library-hall">
    <header class="hall-header">
      <div class="header-decoration">📜</div>
      <h1>藏书阁</h1>
      <p>记录思考，求索未知</p>
    </header>

    <div class="article-grid">
      {allPosts.map(post => (
        <a href={`/writing/${post.slug}`} class="article-card">
          <div class="cover-container">
            <Image src={post.data.cover} alt={post.data.title} width={600} height={400} />
          </div>
          <div class="card-content">
            <span class="post-date">{post.data.date}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="read-more">开启研读 →</div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .library-hall {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px;
    background-color: #fcfaf7;
  }

  .hall-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .header-decoration { font-size: 2rem; margin-bottom: 10px; }

  .hall-header h1 {
    font-family: 'Noto Serif SC', serif;
    font-size: 2.8rem;
    color: #2c1e14;
    margin-bottom: 15px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 40px;
  }

  .article-card {
    background: #fff;
    border: 1px solid #e8e0d5;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(61, 43, 31, 0.08);
  }

  .cover-container {
    aspect-ratio: 16/10;
    overflow: hidden;
    border-bottom: 1px solid #f0ede9;
  }

  .cover-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .article-card:hover .cover-container img {
    transform: scale(1.05);
  }

  .card-content {
    padding: 25px;
    flex-grow: 1;
  }

  .post-date {
    font-size: 0.85rem;
    color: #a69683;
    display: block;
    margin-bottom: 10px;
  }

  .card-content h2 {
    font-family: 'Noto Serif SC', serif;
    font-size: 1.35rem;
    line-height: 1.4;
    color: #3d2b1f;
    margin-bottom: 15px;
  }

  .card-content p {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .read-more {
    font-size: 0.9rem;
    color: #8d6e63;
    font-weight: bold;
    border-top: 1px solid #f0ede9;
    padding-top: 15px;
  }
</style>