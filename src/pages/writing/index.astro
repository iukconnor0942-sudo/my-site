---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('writing');
allPosts.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
---

<BaseLayout title="藏书阁 · 康予纳安">
  <main class="library-hall">
    <header class="hall-header">
      <div class="hall-code">SYS_ARCHIVE // WRITING_SECTOR</div>
      <h1>藏书阁</h1>
      <p class="hall-subtitle">“静谧求索，在数字深空里打捞思想的共鸣”</p>
      <div class="header-divider"></div>
    </header>

    <div class="article-grid">
      {allPosts.map(post => (
        <a href={`/writing/${post.id}`} class="article-card">
          <div class="cover-wrapper">
            <img 
              src={post.data.cover?.startsWith('/') ? post.data.cover : `/writing/ai-future-cover.png`}
              alt={post.data.title || '文章封面'}
              loading="lazy"
              width="300"
              height="220"
            />
            <div class="scanline-overlay"></div>
          </div>
       
          <div class="card-info">
            <span class="date">{post.data.date}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="card-footer">
              <span class="read-more">开启研读 <span class="blink-arrow">▶</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .library-hall { 
    max-width: 1000px;
    margin: 0 auto; 
    padding: 4rem 2rem; 
  }
  
  .hall-header { 
    text-align: center;
    margin-bottom: 4rem; 
    position: relative;
  }
  .hall-code {
    font-family: var(--font-mono);
    color: var(--cyan);
    font-size: 11px;
    letter-spacing: 0.2em;
    margin-bottom: 8px;
  }
  .hall-header h1 { 
    font-family: var(--font-main);
    color: var(--text); 
    font-size: 2.5rem; 
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }
  .hall-subtitle {
    color: var(--muted);
    font-size: 0.95rem;
    font-family: var(--font-main);
    opacity: 0.8;
  }
  .header-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border) 20%, var(--border) 80%, transparent);
    margin-top: 2rem;
  }

  .article-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); 
    gap: 2.5rem;
  }

  .article-card { 
    text-decoration: none; 
    color: inherit; 
    background: var(--surface-2); 
    border: 1px solid var(--border);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
    box-shadow: 0 4px 16px rgba(0,0,0,0.2); 
    overflow: hidden;
    border-radius: 8px;
    position: relative;
  }
  
  .article-card:hover { 
    transform: translateY(-6px); 
    border-color: var(--purple-border);
    box-shadow: 0 12px 28px rgba(123, 94, 255, 0.15);
  }

  .cover-wrapper { 
    height: 190px; 
    overflow: hidden; 
    background: #080b14;
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  
  .cover-wrapper img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover;
    transition: transform 0.4s ease, opacity 0.3s;
    opacity: 0.8;
  }
  
  .article-card:hover .cover-wrapper img {
    transform: scale(1.03);
    opacity: 0.95;
  }

  /* 数字化矩阵扫描线叠加层 */
  .scanline-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(77,223,255,0.02) 1px, transparent 1px);
    background-size: 100% 4px;
    pointer-events: none;
  }

  .card-info { 
    padding: 1.5rem;
  }
  .card-info h2 { 
    font-family: var(--font-main); 
    font-size: 1.25rem; 
    font-weight: 600;
    margin: 0.5rem 0;
    color: var(--text); 
    line-height: 1.4;
    transition: color 0.2s;
  }
  .article-card:hover .card-info h2 {
    color: var(--cyan);
  }
  .date { 
    font-family: var(--font-mono);
    font-size: 0.85rem; 
    color: var(--cyan);
    opacity: 0.8;
  }
  .card-info p { 
    font-size: 0.9rem; 
    color: var(--muted); 
    line-height: 1.6; 
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .card-footer {
    border-top: 1px solid rgba(123,94,255,0.1);
    padding-top: 1rem;
  }
  .read-more { 
    font-family: var(--font-mono);
    font-size: 0.85rem; 
    color: var(--purple); 
    font-weight: bold; 
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }
  .blink-arrow {
    font-size: 9px;
    color: var(--cyan);
    animation: blink 1s step-end infinite;
  }
  .article-card:hover .read-more {
    color: var(--cyan);
  }

  @media (max-width: 768px) {
    .library-hall { padding: 2rem 1.2rem; }
    .hall-header { margin-bottom: 2.5rem; }
    .hall-header h1 { font-size: 1.9rem; }
    .article-grid { gap: 1.5rem; }
  }
</style>