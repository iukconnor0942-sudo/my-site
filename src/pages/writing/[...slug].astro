---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;  // [..slug] 的参数其实是数组，但我们先简单取第一个
const post = await getEntry('writing', slug?.[0] || slug);

if (!post) {
  return Astro.redirect('/404');  // 或者你自己弄个 404 页面
}

const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} · 藏书阁`}>
  <main class="post-page" style="max-width: 800px; margin: 0 auto; padding: 4rem 2rem; background: #fdfbf7;">
    <img 
      src={post.data.cover} 
      alt={post.data.title}
      style="width: 100%; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 8px 24px rgba(0,0,0,0.1);"
    />
    <h1 style="font-family: 'Noto Serif SC', serif; color: #3d2b1f; text-align: center;">{post.data.title}</h1>
    <p style="text-align: center; color: #a69683; margin-bottom: 3rem;">{post.data.date}</p>
    
    <article class="prose">
      <Content />
    </article>
  </main>
</BaseLayout>