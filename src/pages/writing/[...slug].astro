---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 🔥 必须加这个！静态构建专用
export async function getStaticPaths() {
  const allPosts = await getCollection('writing');
  return allPosts.map((post) => ({
    params: { slug: post.slug }   // 这里是字符串！不是数组
  }));
}

const { slug } = Astro.params;
const post = await getEntry('writing', slug);

if (!post) {
  return Astro.redirect('/404');  // 或者你自己做一个 404 页面也行～
}

const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} · 藏书阁`}>
  <main class="post-page" style="max-width: 800px; margin: 0 auto; padding: 4rem 2rem; background: #fdfbf7;">
    <img 
      src={post.data.cover} 
      alt={post.data.title}
      style="width: 100%; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 8px 24px rgba(0,0,0,0.1);"
    />
    <h1 style="font-family: 'Noto Serif SC', serif; color: #3d2b1f; text-align: center; margin-bottom: 0.5rem;">{post.data.title}</h1>
    <p style="text-align: center; color: #a69683; margin-bottom: 3rem;">{post.data.date}</p>
    
    <article class="prose" style="line-height: 1.8; font-size: 1.05rem;">
      <Content />
    </article>
  </main>
</BaseLayout>