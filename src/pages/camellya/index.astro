---
import BaseLayout from '../../layouts/BaseLayout.astro';

const characters = [
  {
    id: 'luoxue', href: '/camellya/luoxue',
    name: '络雪', en: 'Luoxue', role: '键盘 · 布偶猫', color: 'sky',
    desc: '乐队的键盘手，布偶猫，虽然是有钱人家的大小姐但是在家里以外完全没有大小姐的气派，不过因此会对一些奇怪的东西感兴趣。待人亲切温和，性格上还有些小孩子气。',
    tags: ['键盘手', '布偶猫'],
  },
  {
    id: 'baibu', href: '/camellya/baibu',
    name: '百部', en: 'Baibu', role: '主音吉他 · 小青龙', color: 'indigo',
    desc: '乐队的主音吉他手，乐观阳光，乐队里面的小天使，天然治愈。弹起吉他时整个人都会变得不一样，是个很可爱很听话的小男生，和晴舒相依为命。',
    tags: ['吉他手', '热情治愈'],
  },
  {
    id: 'qingshu', href: '/camellya/qingshu',
    name: '晴舒', en: 'Qingshu', role: '架子鼓 · 小金色边牧', color: 'sea',
    desc: '乐队的鼓手兼队长，和百部相依为命，说话直接，遇事不慌，温柔可靠，却是最认真负责的那一个。节奏稳如磐石，是乐队的骨架。',
    tags: ['架子鼓', '队长'],
  },
  {
    id: 'richu', href: '/camellya/richu',
    name: '日出', en: 'Richu', role: '贝斯 · 主唱 · 三花猫', color: 'sakura',
    desc: '乐队的贝斯手兼主唱，调皮古灵精怪，台上认真投入，台下调皮捣蛋 gleeful。',
    tags: ['贝斯主唱', '三花猫'],
  },
];
---


<BaseLayout title="CamEllya · 康予纳安">

  <div id="sakura-env" aria-hidden="true"></div>

  <div id="youth-splash" class="youth-splash">
    <div class="splash-content">
      <div class="splash-track">
        <span class="note animate-note-1">♩</span>
        <span class="note animate-note-2">♪</span>
        <span class="note animate-note-3">♫</span>
      </div>
      <h1 class="splash-title">CamEllya</h1>
      <p class="splash-subtitle">我们的旋律，在青春里交错共鸣</p>
    </div>
    <div class="splash-curtain-left"></div>
    <div class="splash-curtain-right"></div>
  </div>

  <nav class="nav">
    <a href="/" class="nav-logo">
      <span class="logo-note">♬</span>
      <span>康予纳安</span>
    </a>
    <div class="nav-links">
      <a href="/explore">到处看看</a>
      <a href="/camellya" class="nav-active nav-accent">CamEllya</a>
      <a href="/changelog">更新日志</a>
      <a href="/about">关于我</a>
    </div>
  </nav>

  <section class="cam-hero">
    <div class="hero-sky-bg"></div>
    <div class="hero-clouds"></div>
    <div class="cam-hero-inner">
      <div class="cam-sys-label">
        青春特写 · 校园乐队物语 · 连载中
      </div>
      <div class="cam-logo-row">
        <span class="cam-big-title">CamEllya</span>
        <span class="cam-title-badge">部室主页</span>
      </div>
      <p class="cam-tagline">青春随笔 ✧ 角色档案 ✧ 音乐排练室</p>
      <p class="cam-desc">
        CamEllya 是一个由康纳构建的青春创作宇宙。在蝉鸣与落日交织的校园角落，四个性格迥异的少年少女因音乐相遇，在属于他们的音符里演奏着关于成长、友情与寻找自我的温柔故事。
      </p>
      <div class="cam-nav-pills">
        <a href="#characters" class="pill pill-primary">遇见社员 →</a>
        <a href="#world" class="pill pill-ghost">舞台背景 →</a>
        <a href="#comics" class="pill pill-ghost">社团日志 →</a>
      </div>
    </div>
  </section>

  <section class="section" id="characters">
    <div class="section-hd">
      <div class="section-label-row">
        <span class="youth-badge">TRACK_01</span>
        <span class="label-text">乐团成员档案</span>
      </div>
    </div>

    <div class="char-grid">
      {characters.map(c => (
        <a class={`char-card char-${c.color}`} href={c.href}>
          <div class="char-top">
            <div class="char-photo-frame">
              <img
                src={`/images/camellya/${c.id}.png`}
                alt={c.name}
                class="char-avatar"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="char-avatar-fallback">
                {c.name[0]}
              </div>
            </div>
            <div class="tape-deco"></div>
          </div>
          <div class="char-body">
            <div class="char-name-row">
              <span class="char-name">{c.name}</span>
              <span class="char-en">{c.en}</span>
            </div>
            <div class="char-role">{c.role}</div>
            <p class="char-desc">{c.desc}</p>
            <div class="char-tags">
              {c.tags.map(t => (
                <span class={`ctag ctag-${c.color}`}>{t}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-alt" id="world">
    <div class="section-hd">
      <div class="section-label-row">
        <span class="youth-badge">TRACK_02</span>
        <span class="label-text">世界观与乐章</span>
      </div>
    </div>

    <div class="world-grid">
      <div class="world-card">
        <div class="world-icon">🌤️</div>
        <div class="world-name">舞台背景</div>
        <p class="world-desc">故事发生在一座临海的温柔城市中。午后洒进排练室的金色阳光、天台上吹过的微风，音乐成为了少年们连接彼此最纯粹的桥梁。</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🎸</div>
        <div class="world-name">乐团起源</div>
        <p class="world-desc">四个人因为放学后一次奇妙的乐器交响而驻足。各自带着青春期的敏感与固执，在这个小小的空间里，用声音填补彼此青春的空白。</p>
      </div>
      <div class="world-card">
        <div class="world-icon">🌸</div>
        <div class="world-name">物语内核</div>
        <p class="world-desc">关于陪伴、那些无法轻易说出口的悸动，以及在傍晚的晚霞里，大家一起为了同一个音符拼尽全力的夏天。</p>
      </div>
    </div>

    <div class="world-notice">
      <span class="notice-heart">♪</span>
      社团 activity 记录持续更新中，期待下一次排练的旋律
    </div>
  </section>

  <section class="section" id="comics">
    <div class="section-hd">
      <div class="section-label-row">
        <span class="youth-badge">TRACK_03</span>
        <span class="label-text">小说正传</span>
      </div>
    </div>

    <div class="story-grid">
      <a href="/camellya/story/episode-1" class="story-card">
        <div class="story-number">第一话</div>
        <h3 class="story-card-title">「一首歌写不完」</h3>
        <p class="story-card-desc">百部提议四个人一起写首自己的歌。从副歌开始，四个人的意见频频相错，但络雪的一句话拨开了分歧。排练室里，一个想法开始生根。</p>
        <div class="story-card-footer">在排练室，在便利店，他们四个开始铺陈属于自己的旋律</div>
      </a>
      <a href="/camellya/story/episode-2" class="story-card">
        <div class="story-number">第二话</div>
        <h3 class="story-card-title">「四个人，一个锅」</h3>
        <p class="story-card-desc">晴舒邀请他们周六来家吃饭。买菜、做饭、围着热锅，这是四个人第一次这样聚在一起。在蒸腾的热气中，日出想到了那首歌的新词。</p>
        <div class="story-card-footer">还没起飞的那一秒，是他们想要永远抓住的青春</div>
      </a>
    </div>

    <div class="story-notice">
      <span class="notice-icon">✍️</span>
      <p>新的故事仍在创作中，期待在音符里再次相遇</p>
    </div>
  </section>

  <footer class="footer">
    <span>© 2026 康予纳安 · CamEllya 物语宇宙</span>
    <span class="footer-dot">愿青春歌声永不谢幕 ✦</span>
  </footer>

  <div id="dimension-shatter-overlay" aria-hidden="true">
    <div class="matrix-grid-bg"></div>
    <div class="terminal-override-box">
      <div class="glitch-text" data-text="REALITY_DECONSTRUCTING">REALITY_DECONSTRUCTING</div>
      <div class="loading-status">OVERRIDING_CAMPUS_ENVIRONMENT... <span class="percent">00%</span></div>
    </div>
    <div class="horizontal-shutter top"></div>
    <div class="horizontal-shutter bottom"></div>
  </div>

</BaseLayout>

<script is:inline>
  (() => {
    const splash = document.getElementById('youth-splash');
    if (!splash) return;

    const hasVisited = sessionStorage.getItem('camellya_visited');

    if (!hasVisited) {
      sessionStorage.setItem('camellya_visited', 'true');
      setTimeout(() => {
        splash.classList.add('fade-out');
        setTimeout(() => { splash.style.display = 'none'; }, 800);
      }, 2500);
    } else {
      splash.classList.add('is-short');
      setTimeout(() => {
        splash.classList.add('fade-out');
        setTimeout(() => { splash.style.display = 'none'; }, 400);
      }, 600);
    }
  })();
</script>

<script>
  // 🌸 樱花动态粒子引擎
  const spawnSakuraSystem = () => {
    const env = document.getElementById('sakura-env');
    if (!env) return;

    env.innerHTML = '';

    const maxPetals = 24;
    let activePetals = 0;
    const createPetal = (isInitial = false) => {
      if (activePetals >= maxPetals) return;
      activePetals++;
      const petal = document.createElement('div');
      const inner = document.createElement('div');
      petal.className = 'sakura-petal';
      inner.className = 'sakura-inner';

      const scale = Math.random() * 0.6 + 0.5;
      const fallDuration = Math.random() * 6 + 7;
      const swayDuration = Math.random() * 2 + 2;
      const delay = isInitial ? Math.random() * -10 : Math.random() * -0.5;

      petal.style.left = `${Math.random() * 100}vw`;
      petal.style.animationDuration = `${fallDuration}s`;
      petal.style.animationDelay = `${delay}s`;
      petal.style.transform = `scale(${scale})`;

      inner.style.animationDuration = `${swayDuration}s`;
      inner.style.animationDelay = `${delay}s`;
      const hueShift = Math.floor(Math.random() * 15);
      inner.style.background = `linear-gradient(135deg, #fff0f2 0%, hsl(348, 100%, ${78 + hueShift}%) 100%)`;

      petal.appendChild(inner);
      env.appendChild(petal);
      setTimeout(() => {
        petal.remove();
        activePetals--;
        createPetal(false);
      }, (fallDuration) * 1000);
    };

    for (let i = 0; i < maxPetals; i++) {
      createPetal(true);
    }
  };

  // 现实崩解跨维度跳转控制
  const initDimensionTransit = () => {
    spawnSakuraSystem();
    document.querySelectorAll('a').forEach(link => {
      const href = link.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('javascript:') || link.getAttribute('target') === '_blank') return;
      if (link.hostname !== window.location.hostname) return;

      const targetUrl = new URL(href, window.location.href);
      if (targetUrl.pathname === '/camellya' || targetUrl.pathname.startsWith('/camellya/')) return;

      link.addEventListener('click', (e) => {
        e.preventDefault();
        
        document.body.classList.add('reality-shattering');

        const percentEl = document.querySelector('#dimension-shatter-overlay .percent');
        let progress = 0;
        const interval = setInterval(() => {
          progress += Math.floor(Math.random() * 25) + 10;
          if (progress >= 100) {
            progress = 100;
            clearInterval(interval);
          }
          if (percentEl) percentEl.textContent = `${progress.toString().padStart(2, '0')}%`;
        }, 50);

        setTimeout(() => {
          window.location.href = href;
        }, 450);
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initDimensionTransit);
  document.addEventListener('astro:page-load', initDimensionTransit);

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      document.body.classList.remove('reality-shattering');
    }
  });
</script>

<style is:global>
  /* 🌟 全局变量与基本样式升级，增加多层级、高权重选择器与 !important 强力压制外部暗黑样式 */
  :root, html, body, html.dark, [data-theme="dark"], .dark {
    color-scheme: light !important;
    --bg: #f6f8fa !important;
    --surface: #ffffff !important; 
    --surface-2: #fcfdfe !important;
    --sky: #5ba4e5 !important; 
    --sky-light: rgba(91,164,229,0.08) !important; 
    --sky-border: rgba(91,164,229,0.3) !important;
    
    --indigo: #6c71c4 !important;
    --indigo-light: rgba(108,113,196,0.08) !important; 
    --indigo-border: rgba(108,113,196,0.3) !important;
    
    --sea: #4ca1a3 !important; 
    --sea-light: rgba(76,161,163,0.08) !important;
    --sea-border: rgba(76,161,163,0.3) !important;
    
    --sakura: #ff8da1 !important; 
    --sakura-light: rgba(255,141,161,0.09) !important; 
    --sakura-border: rgba(255,141,161,0.35) !important;
    
    --text: #3a424a !important; 
    --muted: #66727f !important;
    --hint: #9faec0 !important; 
    --border: rgba(91,164,229,0.12) !important;
    --font-youth: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Microsoft YaHei', sans-serif !important;
  }

  /* 🌸 强制捕获并粉碎针对系统预设或容器级别的暗黑样式 */
  @media (prefers-color-scheme: dark) {
    :root, html, body, html.dark, [data-theme="dark"], .dark {
      color-scheme: light !important;
      --bg: #f6f8fa !important;
      --surface: #ffffff !important; 
      --surface-2: #fcfdfe !important;
      --text: #3a424a !important; 
      --muted: #66727f !important;
      --hint: #9faec0 !important; 
      --border: rgba(91,164,229,0.12) !important;
    }
  }

  body {
    background-color: var(--bg) !important;
    color: var(--text) !important;
    font-family: var(--font-youth);
    margin: 0;
  }

  body.reality-shattering nav,
  body.reality-shattering section,
  body.reality-shattering footer,
  body.reality-shattering #sakura-env {
    animation: deconstructPage 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: none;
  }

  /* 🌸 樱花容器与物理轨道 */
  #sakura-env {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    overflow: hidden;
  }

  .sakura-petal {
    position: absolute;
    top: -40px;
    will-change: transform;
    animation: sakura-vertical-fall linear forwards;
  }

  .sakura-inner {
    width: 14px;
    height: 11px;
    border-radius: 150% 10% 150% 150%;
    box-shadow: 0 2px 5px rgba(255, 141, 161, 0.2);
    will-change: transform;
    animation: sakura-3d-sway ease-in-out infinite alternate;
  }

  @keyframes sakura-vertical-fall {
    0% { top: -40px; }
    100% { top: 105vh; }
  }

  @keyframes sakura-3d-sway {
    0% { transform: rotate3d(1, 1, 0, 0deg) translateX(0px); }
    50% { transform: rotate3d(1, 0.5, 1, 180deg) translateX(40px); }
    100% { transform: rotate3d(0.5, 1, 0.5, 360deg) translateX(-20px); }
  }

  #dimension-shatter-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: monospace;
  }

  .matrix-grid-bg {
    position: absolute;
    inset: 0;
    background: #05070d;
    background-image: 
      linear-gradient(rgba(77, 223, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(77, 223, 255, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  body.reality-shattering .matrix-grid-bg {
    opacity: 1;
  }

  .horizontal-shutter {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    background: #080b14;
    border-color: #4dfdfd;
    transition: transform 0.35s cubic-bezier(0.85, 0, 0.15, 1);
  }
  .horizontal-shutter.top { top: 0; transform: translateY(-100%); border-bottom: 0px solid transparent; }
  .horizontal-shutter.bottom { bottom: 0; transform: translateY(100%); border-top: 0px solid transparent; }

  body.reality-shattering .horizontal-shutter.top {
    transform: translateY(0);
    border-bottom: 2px solid #4dfdfd;
    box-shadow: 0 5px 20px rgba(77, 223, 255, 0.2);
  }
  body.reality-shattering .horizontal-shutter.bottom {
    transform: translateY(0);
    border-top: 2px solid #7B5EFF;
    box-shadow: 0 -5px 20px rgba(123, 94, 255, 0.2);
  }

  .terminal-override-box {
    position: relative;
    z-index: 100000;
    text-align: center;
    opacity: 0;
    transform: scale(0.9);
  }
  body.reality-shattering .terminal-override-box {
    opacity: 1;
    transform: scale(1);
    transition: all 0.25s 0.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glitch-text {
    font-size: 1.8rem;
    font-weight: bold;
    color: #fff;
    letter-spacing: 4px;
    position: relative;
    text-shadow: 0 0 10px rgba(255,255,255,0.5);
  }
  .loading-status {
    font-size: 12px;
    color: #7B5EFF;
    margin-top: 12px;
    letter-spacing: 2px;
  }
  .loading-status .percent { color: #4dfdfd; font-weight: bold; }

  @keyframes deconstructPage {
    0% { filter: blur(0) grayscale(0) contrast(1); transform: scale(1); }
    30% { filter: blur(4px) grayscale(0.5) contrast(1.2); transform: scale(0.99) skewX(1deg); }
    100% { filter: blur(12px) grayscale(1) contrast(2); transform: scale(0.95); opacity: 0; }
  }
</style>

<style>
  /* 🌸 局部作用域组件样式保持原本逻辑 */
  .youth-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-curtain-left, .splash-curtain-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: #eef5fa;
    transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1);
    z-index: 1;
  }
  .splash-curtain-left { left: 0; transform-origin: left; }
  .splash-curtain-right { right: 0; transform-origin: right; }

  .splash-content {
    position: relative;
    z-index: 2;
    text-align: center;
    opacity: 1;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .splash-title {
    font-size: 40px;
    font-weight: 600;
    color: var(--sky);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .splash-subtitle {
    font-size: 14px;
    color: var(--muted);
    letter-spacing: 0.05em;
    transition: display 0.2s;
  }
  .splash-track {
    margin-bottom: 16px;
    font-size: 24px;
    color: var(--sakura);
  }
  .note { display: inline-block; margin: 0 4px; animation: bounceNote 0.6s ease-in-out infinite alternate; }
  .animate-note-2 { animation-delay: 0.2s; }
  .animate-note-3 { animation-delay: 0.4s; }

  @keyframes bounceNote {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  .youth-splash.is-short .splash-subtitle { display: none; }
  .youth-splash.is-short .splash-title { font-size: 32px; }
  .youth-splash.is-short .splash-curtain-left,
  .youth-splash.is-short .splash-curtain-right { transition-duration: 0.4s; }

  .youth-splash.fade-out .splash-content { opacity: 0; transform: scale(0.95); }
  .youth-splash.fade-out .splash-curtain-left { transform: scaleX(0); }
  .youth-splash.fade-out .splash-curtain-right { transform: scaleX(0); }

  .nav {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(16px);
    display: flex;
    align-items: center; justify-content: space-between;
    padding: 16px 32px; border-bottom: 1px solid var(--border);
    position: sticky; top: 0;
    z-index: 100;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 8px;
    font-size: 16px; font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .logo-note { color: var(--sky); font-size: 16px; }
  .nav-links { display: flex; gap: 28px; }
