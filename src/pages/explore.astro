---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="到处看看 · 康予纳安">

  <nav class="nav">
    <a href="/" class="nav-logo">
      <span class="logo-arrow">▶</span>
      <span>康予纳安</span>
    </a>
    <div class="nav-links">
      <a href="/explore" class="nav-active">到处看看</a>
      <a href="/camellya" class="nav-accent">CamEllya</a>
      <a href="/changelog">更新日志</a>
      <a href="/about">关于我</a>
    </div>
  </nav>

  <main class="page-main">

    <div class="page-header">
      <span class="page-chip">EXPLORE · SELECT_STAGE</span>
      <h1 class="page-title">到处看看</h1>
      <p class="page-desc">选一个感兴趣的区域，进去逛逛</p>
    </div>

    <!-- 主要入口区块 -->
    <div class="grid-main">

      <a href="/camellya" class="card card-featured">
        <span class="card-corner tl"></span>
        <span class="card-corner br"></span>
        <div class="card-chip card-chip-red">副主页</div>
        <div class="card-icon">◈</div>
        <div class="card-name">CamEllya 专区</div>
        <div class="card-desc">创作宇宙、角色设定、世界观与漫画更新。络雪 · 百部 · 晴舒 · 日出</div>
        <div class="card-arrow">进入专区 →</div>
      </a>

      <a href="/notes" class="card">
        <div class="card-chip card-chip-cyan">笔记</div>
        <div class="card-icon">◉</div>
        <div class="card-name">学习笔记</div>
        <div class="card-desc">整理的各科目知识点，结构化记录，方便查阅复习</div>
        <div class="card-arrow">去看看 →</div>
      </a>

      <a href="/gallery" class="card">
        <div class="card-chip card-chip-cyan">插画</div>
        <div class="card-icon">◇</div>
        <div class="card-name">画廊</div>
        <div class="card-desc">原创插画、角色设计与各类创作作品展示</div>
        <div class="card-arrow">去看看 →</div>
      </a>

      <a href="/writing" class="card">
        <div class="card-chip card-chip-purple">写作</div>
        <div class="card-icon">◎</div>
        <div class="card-name">写作</div>
        <div class="card-desc">短篇故事、诗、散文，以及各种文字创作</div>
        <div class="card-arrow">去看看 →</div>
      </a>

      <a href="/猜猜下一步会开放什么专区～" class="card card-dim">
        <div class="card-chip card-chip-dim">即将上线</div>
        <div class="card-icon card-icon-dim">▷</div>
        <div class="card-name card-name-dim">猜猜下一个开放的专区是什么～</div>
        <div class="card-desc">未完待续... →</div>
      </a>

    </div>

    <!-- 快速入口 -->
    <div class="quick-row">
      <span class="quick-label">QUICK_JUMP</span>
      <div class="quick-links">
        <a href="/about" class="qtag">关于我</a>
        <a href="/changelog" class="qtag">更新日志</a>
        <a href="/camellya#characters" class="qtag qtag-red">角色设定</a>
        <a href="/camellya#world" class="qtag qtag-red">世界观</a>
      </div>
    </div>

  </main>

  <footer class="footer">
    <span>© 2026 康予纳安</span>
    <span class="footer-dot">持续更新中 ✦</span>
  </footer>

</BaseLayout>

<style>
:root {
  --font-mono: 'Share Tech Mono', 'Courier New', monospace;
  --bg: #080b14; --surface: #0d1020; --surface-2: #131a2e;
  --purple: #7B5EFF; --purple-light: rgba(123,94,255,0.1); --purple-border: rgba(123,94,255,0.28);
  --cyan: #4DDFFF; --cyan-light: rgba(77,223,255,0.07); --cyan-border: rgba(77,223,255,0.25);
  --red: #FF4D8F; --red-light: rgba(255,77,143,0.08); --red-border: rgba(255,77,143,0.28);
  --text: #E8EAFF; --muted: #8B8FA8; --hint: #4a4e6a; --border: rgba(123,94,255,0.15);
}

.nav {
  background: rgba(13,16,32,0.96); backdrop-filter: blur(14px);
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 32px; border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
}
.nav-logo {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--font-mono); font-size: 15px;
  font-weight: 600; color: var(--text); letter-spacing: 0.06em;
}
.logo-arrow { color: var(--cyan); font-size: 10px; animation: blink 1.4s step-end infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
.nav-links { display: flex; gap: 24px; }
.nav-links a {
  font-family: var(--font-mono); font-size: 13px; color: var(--muted);
  letter-spacing: 0.03em; transition: color 0.2s; white-space: nowrap;
}
.nav-links a:hover { color: var(--cyan); }
.nav-active { color: var(--cyan) !important; }
.nav-accent { color: var(--red) !important; }

.page-main { max-width: 960px; margin: 0 auto; padding: 52px 32px 48px; }

.page-header { margin-bottom: 44px; }
.page-chip {
  font-family: var(--font-mono); font-size: 10px; color: var(--cyan);
  letter-spacing: 0.14em; background: var(--cyan-light); border: 1px solid var(--cyan-border);
  padding: 2px 10px; border-radius: 2px; display: inline-block; margin-bottom: 12px;
}
.page-title { font-size: 28px; font-weight: 500; color: var(--text); margin-bottom: 8px; }
.page-desc { font-size: 14px; color: var(--muted); font-family: var(--font-mono); letter-spacing: 0.04em; }

/* ─ GRID ─ */
.grid-main {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 32px;
}
.card {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 24px 22px;
  display: flex; flex-direction: column; gap: 10px;
  text-decoration: none; color: inherit;
  transition: border-color 0.22s, background 0.22s;
  position: relative;
  overflow: hidden;
}
.card:hover { border-color: var(--purple-border); background: rgba(123,94,255,0.05); }

/* featured card spans 2 columns */
.card-featured {
  grid-column: span 2;
  border-color: var(--red-border);
  background: rgba(255,77,143,0.04);
}
.card-featured:hover { border-color: var(--red); background: rgba(255,77,143,0.07); }

/* pixel corners on featured */
.card-corner { position: absolute; width: 10px; height: 10px; pointer-events: none; }
.card-corner.tl { top:-1px; left:-1px; border-top:2px solid var(--cyan); border-left:2px solid var(--cyan); }
.card-corner.br { bottom:-1px; right:-1px; border-bottom:2px solid var(--cyan); border-right:2px solid var(--cyan); }

.card-dim { opacity: 0.45; pointer-events: none; }

.card-chip {
  font-family: var(--font-mono); font-size: 10px;
  padding: 2px 9px; border-radius: 2px; width: fit-content;
  letter-spacing: 0.08em;
}
.card-chip-cyan  { background: var(--cyan-light);   color: var(--cyan);   border: 1px solid var(--cyan-border); }
.card-chip-purple{ background: var(--purple-light); color: var(--purple); border: 1px solid var(--purple-border); }
.card-chip-red   { background: var(--red-light);    color: var(--red);    border: 1px solid var(--red-border); }
.card-chip-dim   { background: rgba(255,255,255,0.04); color: var(--hint); border: 1px solid var(--border); }

.card-icon { font-size: 22px; color: var(--cyan); opacity: 0.7; line-height: 1; }
.card-icon-dim { color: var(--hint); }
.card-name { font-size: 15px; font-weight: 500; color: var(--text); }
.card-name-dim { color: var(--hint); }
.card-desc { font-size: 12px; color: var(--muted); line-height: 1.7; flex: 1; }
.card-arrow {
  font-family: var(--font-mono); font-size: 12px; color: var(--purple);
  letter-spacing: 0.04em; margin-top: 4px;
  transition: color 0.2s;
}
.card:hover .card-arrow { color: var(--cyan); }
.card-featured .card-arrow { color: var(--red); }
.card-featured:hover .card-arrow { color: #fff; }

/* ─ QUICK ROW ─ */
.quick-row {
  display: flex; align-items: center; gap: 16px;
  padding: 18px 20px;
  border: 1px solid var(--border); border-radius: 4px;
  background: var(--surface-2);
  flex-wrap: wrap;
}
.quick-label {
  font-family: var(--font-mono); font-size: 10px; color: var(--hint);
  letter-spacing: 0.12em; white-space: nowrap; flex-shrink: 0;
}
.quick-links { display: flex; gap: 8px; flex-wrap: wrap; }
.qtag {
  font-family: var(--font-mono); font-size: 11px;
  padding: 4px 12px; border-radius: 2px;
  border: 1px solid var(--border); color: var(--muted);
  letter-spacing: 0.04em; transition: all 0.2s;
}
.qtag:hover { border-color: var(--cyan-border); color: var(--cyan); }
.qtag-red { border-color: var(--red-border); color: var(--red); }
.qtag-red:hover { background: var(--red); color: #fff; }

.footer {
  padding: 18px 32px; display: flex; justify-content: space-between;
  font-size: 12px; color: var(--hint); border-top: 1px solid var(--border);
}
.footer-dot { font-family: var(--font-mono); color: var(--purple); }

@media (max-width: 768px) {
  .nav { padding: 12px 16px; }
  .nav-links { gap: 16px; }
  .nav-links a { font-size: 12px; }
  .page-main { padding: 28px 16px; }
  .grid-main { grid-template-columns: 1fr; }
  .card-featured { grid-column: span 1; }
  .quick-row { flex-direction: column; align-items: flex-start; gap: 12px; }
  .footer { flex-direction: column; align-items: center; gap: 8px; padding: 20px 16px; }
}
</style>