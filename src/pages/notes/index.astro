---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 1. 安全获取数据，如果集合不存在则返回空数组
let allNotes = [];
try {
  allNotes = await getCollection('notes');
} catch (e) {
  console.log("Notes collection not found yet");
}

const categories = ['BJU PRESS', '知识可视化', '编程实践'];

// 2. 预先处理好数据结构，避免在下方模板中使用复杂的箭头函数
const displayGroups = categories.map(catName => {
  return {
    name: catName,
    items: allNotes.filter(n => n.data.category === catName)
  };
});
---

<BaseLayout title="笔记专区 · 康予纳安">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />

  <main style="background: #050505; color: white; min-height: 100vh; padding: 120px 40px;">
    <section style="max-width: 1000px; margin: 0 auto;">
      <nav style="font-size: 11px; color: #666; letter-spacing: 2px; margin-bottom: 20px;">EXPLORE / NOTES</nav>
      <h1 style="font-size: 48px; margin-bottom: 40px;">知识库<span style="color: #333;">.</span></h1>

      {displayGroups.map(group => (
        group.items.length > 0 && (
          <div style="margin-bottom: 60px;">
            <h2 style="font-size: 14px; color: #666; border-bottom: 1px solid #222; padding-bottom: 10px; margin-bottom: 24px;">{group.name}</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
              {group.items.map(note => (
                <a href={`/notes/${note.slug}`} style="text-decoration: none; color: inherit; background: #0f0f0f; border: 1px solid #1f1f1f; border-radius: 12px; overflow: hidden; display: block;">
                  <div style="height: 160px; background: #111;">
                    <img src={note.data.cover} style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); opacity: 0.6;" />
                  </div>
                  <div style="padding: 20px;">
                    <h3 style="font-size: 20px; margin: 0 0 10px 0;">{note.data.title}</h3>
                    <p style="font-size: 14px; color: #666; line-height: 1.5;">{note.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      ))}
      
      {allNotes.length === 0 && (
        <p style="color: #444; font-style: italic;">暂无笔记，请在 src/content/notes 下添加 Markdown 文件。</p>
      )}
    </section>
  </main>
</BaseLayout>