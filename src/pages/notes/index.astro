---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 1. 获取所有笔记
const allNotes = await getCollection('notes');

// 2. 明确分类
const categories = ['BJU PRESS', '知识可视化', '编程实践'];

// 3. 预处理数据：避免在 HTML 模板里写复杂的逻辑
const categorizedData = categories.map(cat => {
  return {
    name: cat,
    notes: allNotes.filter(n => n.data.category === cat)
  };
});
---

<BaseLayout title="笔记专区 · 康予纳安">
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
  />

  <main class="note-container">
    <header class="note-hero">
      <div class="header-inner">
        <nav class="breadcrumb">EXPLORE / KNOWLEDGE BASE</nav>
        <h1>知识库<span>.</span></h1>
        <p class="manifesto">在这里，知识被解构、重组，并最终可视化。</p>
      </div>
    </header>

    <div class="content-wrapper">
      {categorizedData.map((group) => (
        // 只有当该组下有笔记时才渲染
        group.notes.length > 0 && (
          <section class="cat-section">
            <div class="cat-header">
              <span class="cat-dot"></span>
              <h2>{group.name}</h2>
            </div>
            
            <div class="note-grid">
              {group.notes.map((note) => (
                <a href={`/notes/${note.slug}`} class="note-card">
                  <div class="card-img-wrapper">
                    <img src={note.data.cover} alt={note.data.title} />
                    <div class="overlay"></div>
                  </div>
                  <div class="card-content">
                    <span class="card-type">NOTE</span>
                    <h3>{note.data.title}</h3>
                    <p>{note.data.description}</p>
                    <div class="card-footer">
                      <span>进入阅读</span>
                      <span class="arrow">→</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      ))}
    </div>

    <section class="formula-footer">
      <div class="formula-box">
        <div class="math">
          $$ c = \sqrt{a^2 + b^2} $$
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* 保持之前的黑白灰风格样式不变 */
  :root { --bg: #050505; --surface: #0f0f0f; --border: #1f1f1f; --text-main: #ffffff; --text-dim: #888888; }
  .note-container { background: var(--bg); color: var(--text-main); min-height: 100vh; padding-bottom: 100px; }
  .note-hero { padding: 120px 40px 60px; max-width: 1200px; margin: 0 auto; }
  .breadcrumb { font-size: 11px; color: var(--text-dim); margin-bottom: 20px; }
  .note-hero h1 { font-size: 56px; margin: 0; }
  .content-wrapper { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .cat-section { margin-bottom: 80px; }
  .cat-header { display: flex; align-items: center; gap: 12px; margin-bottom: 30px; border-bottom: 1px solid var(--border); padding-bottom: 15px; }
  .cat-dot { width: 6px; height: 6px; background: #fff; border-radius: 50%; }
  .note-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px; }
  .note-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; transition: 0.3s; }
  .note-card:hover { border-color: #444; transform: translateY(-5px); }
  .card-img-wrapper { height: 160px; position: relative; }
  .card-img-wrapper img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); }
  .overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent, var(--surface)); }
  .card-content { padding: 20px; }
  .card-type { font-size: 10px; color: var(--text-dim); }
  .card-footer { display: flex; justify-content: space-between; font-size: 12px; margin-top: 20px; color: var(--text-dim); }
  .formula-footer { padding: 60px; text-align: center; border-top: 1px solid var(--border); }
</style>