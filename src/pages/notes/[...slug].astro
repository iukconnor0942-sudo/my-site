---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title}>
  <article class="note-container">
    <header class="note-header">
      <div class="meta">
        <a href="/notes" class="back-link">KNOWLEDGE_BASE</a> / 
        <span class="category-tag">{note.data.category || 'AI RESEARCH'}</span>
      </div>
      <h1>{note.data.title}<span class="title-dot">.</span></h1>
      <p class="description">{note.data.description}</p>
    </header>

    <div class="divider-line"></div>

    <div class="markdown-content">
      <Content />
    </div>

    <footer class="note-footer">
      <a href="/notes" class="back-to-list"><span class="arrow">◀</span> RETURN_TO_BASE</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .note-container {
    width: 100% !important;
    max-width: 900px !important;
    margin: 0 auto;
    padding: 5rem 2rem !important; 
    min-height: 100vh;
    box-sizing: border-box;
  }

  .note-header { margin-bottom: 3.5rem; }
  .meta { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--muted); margin-bottom: 20px; text-transform: uppercase; }
  .back-link { color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .back-link:hover { color: var(--cyan); }
  .category-tag { color: var(--cyan); font-weight: 600; }
  
  .note-container h1 { 
    font-family: var(--font-main);
    font-size: clamp(28px, 5vw, 44px);
    margin: 10px 0; 
    font-weight: 600; 
    color: var(--text); 
    line-height: 1.2;
  }
  .note-container h1 .title-dot { color: var(--purple); }
  .description { font-size: 1.05rem; color: var(--muted); line-height: 1.6; max-width: 800px; margin-top: 15px; opacity: 0.85; }

  .divider-line { height: 1px; background: linear-gradient(90deg, var(--border), transparent); margin: 3.5rem 0; }

  /* 🤖 Markdown 深度黑客美化 */
  .markdown-content {
    font-family: var(--font-main);
    font-size: 1.05rem;
    line-height: 1.95;
    color: var(--text);
    word-wrap: break-word;
  }

  /* 💻 终端代码块优化 */
  pre {
    background: #05070d !important;
    border: 1px solid var(--border);
    padding: 1.8rem !important;
    border-radius: 12px !important;
    margin: 2.5rem 0 !important;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3) !important;
    overflow-x: auto;
  }
  code {
    font-family: var(--font-mono) !important;
    font-size: 0.9em !important;
  }

  /* 💎 KaTeX 公式（完美融入暗色数字深空） */
  .katex-display {
    background: var(--surface-2) !important;
    padding: 1.8rem !important;
    border-radius: 12px !important;
    margin: 3rem 0 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1) !important;
    border: 1px solid var(--border);
    overflow-x: auto; 
    overflow-y: hidden;
  }

  /* 💡 引用块 */
  .markdown-content blockquote {
    border-left: 4px solid var(--cyan);
    background: linear-gradient(to right, var(--cyan-light), transparent);
    padding: 1.5rem 2rem;
    border-radius: 0 12px 12px 0;
    margin: 2.5rem 0;
    color: var(--text);
    opacity: 0.9;
  }

  .markdown-content h2 { 
    font-family: var(--font-main);
    font-size: clamp(20px, 4vw, 1.8rem);
    margin-top: 3.5rem; 
    margin-bottom: 1.2rem;
    padding-bottom: 10px;
    color: var(--cyan);
    font-weight: 600;
    line-height: 1.3;
    border-bottom: 1px dashed var(--border);
  }
  
  .markdown-content h3 {
    font-family: var(--font-main);
    font-size: clamp(16px, 3.5vw, 1.4rem);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--purple);
    font-weight: 600;
  }

  .note-footer { margin-top: 6rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  .back-to-list { font-family: var(--font-mono); color: var(--purple); text-decoration: none; font-weight: 600; font-size: 1rem; display: inline-flex; align-items: center; gap: 6px; transition: color 0.2s; }
  .back-to-list .arrow { font-size: 9px; color: var(--cyan); }
  .back-to-list:hover { color: var(--cyan); }

  /* 📱 移动端强效覆盖 */
  @media (max-width: 768px) {
    .note-container { padding: 3rem 1.2rem !important; }
    .note-header { margin-bottom: 2.5rem; }
    .note-container h1 { font-size: 24px !important; }
    .description { font-size: 0.95rem !important; }
    .markdown-content h2 { font-size: 20px !important; margin-top: 2.5rem; }
    pre { padding: 1.2rem !important; margin: 1.5rem 0 !important; border-radius: 8px !important; }
    .katex-display { padding: 1.2rem !important; border-radius: 8px !important; }
    .markdown-content blockquote { padding: 1.2rem 1.5rem; margin: 2rem 0; }
  }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script>
  import renderMathInElement from 'katex/contrib/auto-render';
  const init = () => {
    renderMathInElement(document.body, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false }
      ],
      throwOnError: false
    });
  };
  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>