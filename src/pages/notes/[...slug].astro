---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. 生成所有笔记的路径
export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

// 2. 获取笔记数据
const { note } = Astro.props;
// 3. 解析内容
const { Content } = await render(note);
---

<BaseLayout title={note.data.title}>
  <article class="note-container">
    <header class="note-header">
      <div class="meta">
        <a href="/notes" class="back-link">KNOWLEDGE BASE</a> / 
        <span class="category-tag">{note.data.category}</span>
      </div>
      <h1>{note.data.title}<span>.</span></h1>
      <p class="description">{note.data.description}</p>
      </header>

    <hr class="divider" />

    <div class="markdown-content">
      <Content />
    </div>

    <footer class="note-footer">
      <a href="/notes" class="back-to-list">← 返回列表</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* 全局通用桌面端全屏样式 */
  
  .note-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0;
    /* 🛠️ 优化：图片没了，把上边距稍微加大一点，更有设计感 */
    padding: 100px 6% !important; 
    background-color: #F8FAFC; 
    min-height: 100vh;
  }

  .note-header { 
    /* 🛠️ 优化：把头部边距稍微加大，显得不那么挤 */
    margin-bottom: 60px; 
  }
  
  .meta { font-size: 12px; letter-spacing: 1px; color: #888; margin-bottom: 25px; }
  .back-link { color: inherit; text-decoration: none; }
  .category-tag { color: #4AACDB; font-weight: 600; }
  
  h1 { font-size: 56px; margin: 10px 0; font-weight: 800; color: #0f172a; }
  h1 span { color: #4AACDB; }
  .description { font-size: 19px; color: #666; line-height: 1.7; max-width: 900px; margin-top: 15px; }
  
  /* 🚧 note-header 里不需要针对 hero-image 的样式了，删掉了 */

  .divider { border: 0; border-top: 1px solid #e2e8f0; margin: 80px 0; }

  /* Markdown & KaTeX 样式强化区 */
  .markdown-content {
    font-size: 1.15rem;
    line-height: 1.9;
    color: #1e293b;
  }

  /* 💎 公式卡片美化（保持你的设置） */
  .katex-display {
    background: white !important;
    padding: 2.8rem !important;
    border-radius: 24px !important;
    margin: 3.5rem 0 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04) !important;
    overflow-x: auto;
    border: 1px solid #f1f5f9;
  }

  .katex { font-size: 1.25em !important; }

  /* 标题和引用（保持设计感） */
  .markdown-content h2 { 
    font-size: 2.4rem; 
    margin-top: 3.5em; 
    border-bottom: 2px solid #f1f5f9; 
    padding-bottom: 15px;
    color: #0f172a;
    font-weight: 800;
  }
  
  .markdown-content blockquote {
    border-left: 6px solid #4AACDB;
    background: #f0f9ff;
    padding: 1.8rem 2.5rem;
    border-radius: 0 16px 16px 0;
    margin: 2.5rem 0;
    font-style: normal;
  }

  .note-footer { margin-top: 100px; padding-top: 50px; border-top: 1px solid #e2e8f0; }
  .back-to-list { color: #4AACDB; text-decoration: none; font-weight: 600; }

  /* 适配移动端 */
  @media (max-width: 768px) {
    .note-container { padding: 60px 5% !important; }
    h1 { font-size: 36px; }
  }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  const initMath = () => {
    renderMathInElement(document.body, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false }
      ],
      throwOnError: false
    });
  };

  document.addEventListener('DOMContentLoaded', initMath);
  document.addEventListener('astro:page-load', initMath);
</script>