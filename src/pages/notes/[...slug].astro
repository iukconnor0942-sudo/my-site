---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// 1. 生成所有笔记的路径
export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id }, // 使用文件 ID 作为路径（如 pre-algebra）
    props: { note },
  }));
}

// 2. 获取笔记数据
const { note } = Astro.props;
// 3. 使用新的 render() 函数解析 Markdown 内容
const { Content, headings } = await render(note);
---

<BaseLayout title={note.data.title}>
  <article class="note-container">
    <header class="note-header">
      <div class="meta">
        <a href="/notes" class="back-link">KNOWLEDGE BASE</a> / 
        <span class="category-tag">{note.data.category}</span>
      </div>
      <h1>{note.data.title}<span>.</span></h1>
      <p class="description">{note.data.description}</p>
      {note.data.cover && (
        <img src={note.data.cover} alt={note.data.title} class="hero-image" />
      )}
    </header>

    <hr class="divider" />

    <div class="markdown-content">
      {/* 渲染 Markdown 转换后的 HTML 内容 */}
      <Content />
    </div>

    <footer class="note-footer">
      <a href="/notes" class="back-to-list">← 返回列表</a>
    </div>
  </article>
</BaseLayout>

<style>
  .note-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 120px 20px;
  }
  .note-header { margin-bottom: 40px; }
  .meta { font-size: 12px; letter-spacing: 1px; color: #888; margin-bottom: 20px; }
  .back-link { color: inherit; text-decoration: none; }
  .category-tag { color: #4AACDB; font-weight: 600; }
  
  h1 { font-size: 48px; margin: 10px 0; font-weight: 800; }
  h1 span { color: #4AACDB; }
  .description { font-size: 18px; color: #666; line-height: 1.6; }
  
  .hero-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 20px;
    margin-top: 30px;
  }

  .divider { border: 0; border-top: 1px solid #eee; margin: 60px 0; }

  /* Markdown 内容样式 */
  .markdown-content {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
  }
  .markdown-content :global(h2) { font-size: 28px; margin-top: 40px; border-bottom: 2px solid #f0f0f0; padding-bottom: 10px; }
  .markdown-content :global(p) { margin-bottom: 1.5em; }
  .markdown-content :global(code) { background: #f5f5f5; padding: 2px 6px; border-radius: 4px; font-family: monospace; }
  
  .note-footer { margin-top: 80px; padding-top: 40px; border-top: 1px solid #eee; }
  .back-to-list { color: #4AACDB; text-decoration: none; font-weight: 600; }
</style>