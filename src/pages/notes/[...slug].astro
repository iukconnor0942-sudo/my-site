---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title}>
  <article class="note-container">
    <header class="note-header">
      <div class="meta">
        <a href="/notes" class="back-link">KNOWLEDGE BASE</a> / 
        <span class="category-tag">{note.data.category || 'AI RESEARCH'}</span>
      </div>
      <h1>{note.data.title}<span>.</span></h1>
      <p class="description">{note.data.description}</p>
    </header>

    <hr class="divider" />

    <div class="markdown-content">
      <Content />
    </div>

    <footer class="note-footer">
      <a href="/notes" class="back-to-list">← 返回列表</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* 🛠️ 桌面端铺满逻辑 */
  .note-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0;
    padding: 100px 8% !important; /* AI 专区需要更多留白来展示代码和图表 */
    background-color: #F8FAFC; 
    min-height: 100vh;
  }

  .note-header { margin-bottom: 60px; }
  .meta { font-size: 12px; letter-spacing: 2px; color: #888; margin-bottom: 25px; text-transform: uppercase; }
  .category-tag { color: #4AACDB; font-weight: 700; }
  
  h1 { font-size: 56px; margin: 10px 0; font-weight: 800; color: #0f172a; letter-spacing: -1px; }
  h1 span { color: #4AACDB; }
  .description { font-size: 20px; color: #64748b; line-height: 1.6; max-width: 900px; margin-top: 15px; }

  .divider { border: 0; border-top: 1px solid #e2e8f0; margin: 60px 0; }

  /* 🤖 AI 专区 & Markdown 深度优化 */
  .markdown-content {
    font-size: 1.15rem;
    line-height: 1.9;
    color: #334155;
  }

  /* 💻 代码块优化（针对 AI 代码、Prompt） */
  pre {
    background: #1e293b !important;
    padding: 2rem !important;
    border-radius: 20px !important;
    margin: 2.5rem 0 !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
    overflow-x: auto;
  }
  code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace !important;
    font-size: 0.95em !important;
  }

  /* 💎 KaTeX 公式（AI 模型中的数学推导） */
  .katex-display {
    background: white !important;
    padding: 2.8rem !important;
    border-radius: 24px !important;
    margin: 3.5rem 0 !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03) !important;
    border: 1px solid #f1f5f9;
  }

  /* 💡 AI 专区的引用块 (Tips/Caveats) */
  .markdown-content blockquote {
    border-left: 6px solid #4AACDB;
    background: linear-gradient(to right, #f0f9ff, #ffffff);
    padding: 1.8rem 2.5rem;
    border-radius: 0 20px 20px 0;
    margin: 3rem 0;
    color: #475569;
  }

  .markdown-content h2 { 
    font-size: 2.4rem; 
    margin-top: 4rem; 
    padding-bottom: 15px;
    color: #0f172a;
    font-weight: 800;
  }

  .note-footer { margin-top: 120px; padding-top: 50px; border-top: 1px solid #e2e8f0; }
  .back-to-list { color: #4AACDB; text-decoration: none; font-weight: 600; font-size: 1.1rem; }

  @media (max-width: 768px) {
    .note-container { padding: 60px 5% !important; }
    h1 { font-size: 36px; }
  }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script>
  import renderMathInElement from 'katex/contrib/auto-render';
  const init = () => {
    renderMathInElement(document.body, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false }
      ],
      throwOnError: false
    });
  };
  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>