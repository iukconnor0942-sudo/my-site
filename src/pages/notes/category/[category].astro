---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  
  // 1. 获取所有分类并去重
  const categories = [...new Set(allNotes.map(note => note.data.category))];

  return categories.map(cat => {
    // 2. 这里的 slug 必须和你在 index.astro 里链接的 href 完全一致
    const catSlug = cat.toLowerCase().replace(/\s+/g, '-');
    
    return {
      params: { category: catSlug },
      props: { 
        categoryName: cat,
        // 3. 过滤出属于该分类的笔记
        notes: allNotes.filter(n => n.data.category === cat) 
      },
    };
  });
}

const { categoryName, notes } = Astro.props;
---

<BaseLayout title={`${categoryName} · 笔记列表`}>
  <main class="category-page">
    <header class="category-header">
      <nav class="breadcrumb">
        <a href="/notes">KNOWLEDGE BASE</a> / {categoryName.toUpperCase()}
      </nav>
      <h1>{categoryName}<span>.</span></h1>
    </header>

    <section class="notes-grid">
      {notes.map((note) => (
        <a href={`/notes/${note.slug}`} class="note-card">
          <div class="card-image">
            <img src={note.data.cover} alt={note.data.title} />
          </div>
          <div class="card-body">
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  /* 保持之前的样式不变 */
  .category-page { max-width: 1200px; margin: 0 auto; padding: 80px 40px; }
  .note-card { display: block; background: #fff; border: 1px solid #eee; border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; }
  .card-image img { width: 100%; height: 200px; object-fit: cover; }
  .card-body { padding: 20px; }
</style>