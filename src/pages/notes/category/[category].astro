---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  const fixedCategories = [
    { slug: 'bju-press', name: 'BJU PRESS' },
    { slug: 'coding', name: 'AI 使用' } 
  ];

  return fixedCategories.map(cat => {
    const normalize = (s) => (s || '').toString().trim().toLowerCase();
    const toSlug = (s) => normalize(s).replace(/\s+/g, '-');

    const filteredNotes = allNotes.filter(n => {
      const catField = n.data?.category;
      return catField && (normalize(catField) === normalize(cat.name) || toSlug(catField) === cat.slug);
    });

    const serializableNotes = filteredNotes.map(n => ({
      id: n.id, // 重要：使用 id 替代 slug
      title: n.data.title,
      description: n.data.description,
      cover: n.data.cover,
      order: n.data.order
    }));

    return {
      params: { category: cat.slug },
      props: { categoryName: cat.name, categorySlug: cat.slug, notes: serializableNotes },
    };
  });
}

const { categoryName, notes } = Astro.props;
---

<BaseLayout title={`${categoryName} · 笔记列表`}>
  <main style="max-width: 1100px; margin: 0 auto; padding: 120px 40px;">
    <header style="margin-bottom: 60px;">
      <h1 style="font-size: 42px;">{categoryName}<span style="color: #4AACDB;">.</span></h1>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
      {notes.map((note) => (
        /* 核心修复：链接指向 note.id */
        <a href={`/notes/${note.id}`} style="text-decoration: none; color: inherit;">
          <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #eee;">
            <img src={note.cover} style="width: 100%; height: 200px; object-fit: cover;" />
            <div style="padding: 24px;">
              <div style="font-size: 10px; color: #4AACDB; font-weight: 800; margin-bottom: 8px;">STEP {note.order}</div>
              <h3 style="margin: 0;">{note.title}</h3>
              <p style="font-size: 14px; color: #666;">{note.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>