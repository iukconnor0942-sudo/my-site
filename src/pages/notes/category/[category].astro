---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 1. 动态生成路径与 props
export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  
  // 找出所有唯一的分类名
  const uniqueCategories = [...new Set(allNotes.map((note) => note.data.category))];

  return uniqueCategories.map((cat) => {
    // 🔥 核心补丁：在这里自动生成该分类对应的封面路径
    // 原理：分类是 "BJU PRESS"，对应的图就是 "/images/notes/covers/bju-press.jpg"
    const catSlug = cat.toLowerCase().replace(/\s+/g, '-');
    const computedCoverPath = `/images/notes/covers/${catSlug}.jpg`;

    return {
      params: { category: catSlug },
      props: { 
        categoryName: cat, 
        notes: allNotes.filter(n => n.data.category === cat),
        categoryCover: computedCoverPath // 将图片路径通过 prop 传下去
      },
    };
  });
}

// 接收 props
const { categoryName, notes, categoryCover } = Astro.props;
---

<BaseLayout title={`${categoryName} · 笔记列表`}>
  <main class="category-page">
    <header class="category-header">
      <div class="header-content">
        <nav class="breadcrumb">
          <a href="/notes">KNOWLEDGE BASE</a> / {categoryName.toUpperCase()}
        </nav>
        <h1>{categoryName}<span>.</span></h1>
        <p class="count">共归档了 {notes.length} 篇理科笔记，正在进行秩序重组。</p>
      </div>
    </header>

    <section class="notes-grid">
      {notes.map((note) => (
        <a href={`/notes/${note.slug}`} class="note-card">
          <div class="card-image">
            {/* 优先检查图片路径，如果没填就用灰色占位 */}
            <img src={note.data.cover || "/images/notes/placeholder.jpg"} alt={note.data.title} loading="lazy" />
          </div>
          <div class="card-body">
            <span class="date-tag">ORDER {note.data.order || '·'}</span>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
            <div class="card-footer">
              <span>进入阅读</span>
              <span class="arrow">→</span>
            </div>
          </div>
        </a>
      ))}
    </section>

    {notes.length === 0 && (
      <div class="empty-state">
        <p>该分类下暂无内容，知识网络正在编织中...</p>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  :root {
    --bg: #F2F4F6;
    --surface: #ffffff;
    --blue: #4AACDB;
    --text-main: #1a1a1a;
    --text-dim: #666;
    --border: #e0e4ea;
  }

  .category-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 40px;
    min-height: 100vh;
  }

  .category-header {
    margin-bottom: 80px;
  }

  .breadcrumb {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--text-dim);
    margin-bottom: 20px;
  }
  .breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
    transition: 0.3s;
  }
  .breadcrumb a:hover { color: var(--blue); }

  h1 { font-size: 56px; margin: 0; font-weight: 700; color: var(--text-main); }
  h1 span { color: #ccc; }
  .count { color: #888; margin-top: 10px; font-size: 14px; }

  /* 笔记卡片网格 */
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .note-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .note-card:hover {
    transform: translateY(-8px);
    border-color: #ccc;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .card-image {
    height: 200px;
    overflow: hidden;
    background: #111;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: 0.6s;
  }
  .note-card:hover .card-image img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  .card-body { padding: 28px; }
  .date-tag { font-size: 10px; color: var(--text-dim); font-weight: 700; letter-spacing: 1px; }
  h3 { font-size: 22px; margin: 12px 0; font-weight: 600; color: var(--text-main); }
  p { font-size: 14px; color: var(--text-dim); line-height: 1.6; margin-bottom: 24px; height: 44px; overflow: hidden; }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-dim);
  }
  .arrow { transition: 0.3s; color: var(--blue); }
  .note-card:hover .arrow { transform: translateX(5px); color: var(--blue); }
  .note-card:hover .card-footer { color: var(--blue); }

  @media (max-width: 768px) {
    .category-page { padding: 100px 24px; }
    h1 { font-size: 40px; }
    .notes-grid { grid-template-columns: 1fr; }
  }
</style>