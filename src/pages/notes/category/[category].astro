---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // 1. 获取所有笔记
  const allNotes = await getCollection('notes');
  
  // 调试点：在构建时控制台会输出数量
  console.log("Astro 扫描到的笔记总数:", allNotes.length);

  // 2. 这里的 slug 必须和你在 index.astro 里链接的一致
  const manualCategories = [
    { slug: 'bju-press', name: 'BJU PRESS' },
    { slug: 'coding', name: 'AI 使用' }
  ];

  return manualCategories.map(cat => {
    // 3. 强力过滤逻辑：去除空格并转大写，防止字符不匹配
    const filteredNotes = allNotes.filter(n => {
      if (!n.data.category) return false;
      const noteCat = n.data.category.trim().toUpperCase();
      const targetCat = cat.name.trim().toUpperCase();
      return noteCat === targetCat;
    });
    
    return {
      params: { category: cat.slug },
      props: { 
        categoryName: cat.name,
        categorySlug: cat.slug,
        notes: filteredNotes,
        debugTotal: allNotes.length // 将总数传给页面
      },
    };
  });
}

const { categoryName, categorySlug, notes, debugTotal } = Astro.props;

// AI 专区的优雅留白文案
const emptyAiMessage = "秩序正在涌现。这里是 AI 浪潮的实验室，目前还在整理实战笔记中，请耐心等待灵感的结构化...";
---

<BaseLayout title={`${categoryName} · 笔记列表`}>
  <main class="category-page">
    <header class="category-header">
      <nav class="breadcrumb">
        <a href="/notes">KNOWLEDGE BASE</a> / {categoryName.toUpperCase()}
      </nav>
      <h1>{categoryName}<span>.</span></h1>
      
      {/* 🛠️ 调试信息：如果笔记不显示，看这里显示的数字 */}
      <div class="debug-info">
        <span>系统检测到 notes 集合总数: {debugTotal}</span>
        <span> | </span>
        <span>当前分类匹配到的笔记: {notes.length}</span>
      </div>
    </header>

    <section class="content-view">
      {/* 情况 A：AI 专区且没笔记 */}
      {categorySlug === 'coding' && notes.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">⌘</div>
          <p class="empty-text">{emptyAiMessage}</p>
          <a href="/notes" class="back-link">← 返回知识库</a>
        </div>
      ) : (
        /* 情况 B：正常显示笔记列表 */
        <div class="notes-grid">
          {notes.length > 0 ? (
            notes.map((note) => (
              <a href={`/notes/${note.slug}`} class="note-card">
                <div class="card-image">
                  <img src={note.data.cover} alt={note.data.title} />
                </div>
                <div class="card-body">
                  <div class="order-tag">STEP {note.data.order || '·'}</div>
                  <h3>{note.data.title}</h3>
                  <p>{note.data.description}</p>
                </div>
              </a>
            ))
          ) : (
            /* 情况 C：本该有笔记但过滤后是 0 */
            <div class="error-box">
              <p>⚠️ 已经进入了 {categoryName}，但没有发现符合分类标签的笔记。</p>
              <p>请确认 MD 文件里的 category 是不是一字不差的 <strong>"{categoryName}"</strong></p>
            </div>
          )}
        </div>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .category-page { max-width: 1100px; margin: 0 auto; padding: 120px 40px; }
  .category-header { margin-bottom: 60px; }
  .breadcrumb { font-size: 11px; letter-spacing: 2px; color: #888; text-decoration: none; }
  .breadcrumb a { color: inherit; text-decoration: none; }
  h1 { font-size: 48px; margin: 10px 0; font-weight: 700; }
  h1 span { color: #4AACDB; }
  
  .debug-info { font-size: 12px; color: #ccc; margin-top: 10px; font-family: monospace; }

  .notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px; }
  .note-card { background: #fff; border: 1px solid #eee; border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; transition: 0.3s; display: block; }
  .note-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
  .card-image img { width: 100%; height: 200px; object-fit: cover; }
  .card-body { padding: 24px; }
  .order-tag { font-size: 10px; color: #4AACDB; font-weight: 800; margin-bottom: 8px; }
  
  .empty-state { text-align: center; padding: 100px 40px; background: #fbfbfb; border: 1px dashed #ddd; border-radius: 20px; }
  .empty-icon { font-size: 40px; color: #ccc; margin-bottom: 20px; }
  .empty-text { font-size: 16px; color: #666; line-height: 1.8; max-width: 460px; margin: 0 auto 30px; }
  .back-link { font-size: 13px; color: #4AACDB; font-weight: 600; text-decoration: none; }

  .error-box { grid-column: 1 / -1; padding: 40px; background: #fff5f5; border: 1px solid #feb2b2; border-radius: 12px; color: #c53030; line-height: 1.6; }
</style>