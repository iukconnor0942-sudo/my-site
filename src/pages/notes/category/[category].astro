---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  const fixedCategories = [
    { slug: 'bju-press', name: 'BJU PRESS' },
    { slug: 'coding', name: 'AI 使用' } 
  ];

  return fixedCategories.map(cat => {
    const normalize = (s) => (s || '').toString().trim().toLowerCase();
    const toSlug = (s) => normalize(s).replace(/\s+/g, '-');

    const filteredNotes = allNotes.filter(n => {
      const catField = n.data?.category;
      return catField && (normalize(catField) === normalize(cat.name) || toSlug(catField) === cat.slug);
    });

    const serializableNotes = filteredNotes.map(n => ({
      id: n.id,
      title: n.data.title,
      description: n.data.description,
      cover: n.data.cover,
      order: n.data.order
    }));

    return {
      params: { category: cat.slug },
      props: { categoryName: cat.name, notes: serializableNotes },
    };
  });
}

const { categoryName, notes } = Astro.props;
---

<BaseLayout title={`${categoryName} · 笔记列表`}>
  <main style="max-width: 1100px; margin: 0 auto; padding: 120px 40px;">
    <h1 style="font-size: 42px; margin-bottom: 60px;">{categoryName}<span style="color: #4AACDB;">.</span></h1>

    {notes.length > 0 ? (
      /* 🐉 情况 A：有笔记时，显示列表网格 */
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
        {notes.map((note) => (
          <a href={`/notes/${note.id}`} style="text-decoration: none; color: inherit;">
            <div style="background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #eee;">
              <img src={note.cover} style="width: 100%; height: 200px; object-fit: cover;" />
              <div style="padding: 24px;">
                <div style="font-size: 10px; color: #4AACDB; font-weight: 800; margin-bottom: 8px;">STEP {note.order}</div>
                <h3 style="margin: 0 0 10px 0;">{note.title}</h3>
                <p style="font-size: 14px; color: #666;">{note.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      /* 🐉 情况 B：没笔记时（比如 AI 专区），显示敬请期待 */
      <div class="coming-soon-container">
        <div class="status-badge">AI RESEARCH IN PROGRESS</div>
        <h2>敬请期待<span>.</span></h2>
        <p>正在构建一个将创意可视化、结构化的 AI 知识库...</p>
        <div class="loading-bar">
          <div class="progress"></div>
        </div>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  /* 🏗️ 敬请期待专属样式 */
  .coming-soon-container {
    padding: 100px 20px;
    text-align: center;
    background: white;
    border-radius: 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.03);
    border: 1px solid #f1f5f9;
  }

  .status-badge {
    display: inline-block;
    padding: 6px 14px;
    background: #eff6ff;
    color: #4AACDB;
    font-size: 11px;
    font-weight: 800;
    border-radius: 100px;
    letter-spacing: 2px;
    margin-bottom: 25px;
  }

  h2 { font-size: 48px; font-weight: 800; color: #0f172a; margin-bottom: 15px; }
  h2 span { color: #4AACDB; }

  p { font-size: 18px; color: #64748b; max-width: 450px; margin: 0 auto 40px; line-height: 1.7; }

  .loading-bar {
    width: 240px;
    height: 6px;
    background: #f1f5f9;
    border-radius: 10px;
    margin: 0 auto;
    overflow: hidden;
  }

  .progress {
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, #4AACDB, #93c5fd);
    border-radius: 10px;
    animation: loading 2.5s infinite ease-in-out;
  }

  @keyframes loading {
    0% { transform: translateX(-110%); }
    50% { transform: translateX(110%); }
    100% { transform: translateX(-110%); }
  }
</style>