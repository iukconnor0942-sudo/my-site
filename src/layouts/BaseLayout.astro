---
const { title } = Astro.props;
import '../styles/global.css';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- 使用系统字体 + 备用字体，避免 Google 字体被挡 -->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=LXGW+WenKai&display=swap');
    </style>

    <!-- 或者直接用系统字体（最稳） -->
    <!-- 
    <style>
      :root {
        --font-main: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
      }
    </style>
    -->
  </head>
  <body>
    <slot />
  </body>
</html>