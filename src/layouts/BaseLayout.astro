---
import Analytics from '@vercel/analytics/astro';
const { title = "康予纳安" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main class="full-screen-layout">
      <slot />
    </main>

    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --primary-color: #2563eb;
  }
  
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-main);
    background-color: #F2F4F6;
    color: #1a1a1a;
    -webkit-font-smoothing: antialiased;
    /* 确保背景颜色铺满全屏 */
    min-height: 100vh;
  }

  /* 🚀 康纳看这里：彻底填充屏幕的配置 */
  .full-screen-layout {
    width: 100%;       /* 宽度直接占满 100% */
    max-width: none;   /* 彻底去掉最大宽度限制 */
    margin: 0;         /* 去掉自动居中产生的边距 */
    padding: 4rem 8%;  /* 留 8% 的边间距防止文字撞墙，其他全部填充 */
    min-height: 100vh;
    background-color: #F2F4F6;
  }

  /* 优化：大屏幕下的标题也要霸气一点 */
  h1 { font-size: 2.5rem; margin-bottom: 1rem; }
  h2 { font-size: 2rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; }

  /* 公式渲染：在大屏幕下更显眼 */
  .katex-display {
    margin: 2rem 0 !important;
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    /* 允许在大屏上横向滚动，防止超长公式挤压页面 */
    overflow-x: auto;
  }

  /* 保持响应式：手机端自动调回小间距 */
  @media (max-width: 768px) {
    .full-screen-layout {
      padding: 2rem 5%;
    }
  }
</style>