---
import Analytics from '@vercel/analytics/astro';
const { title = "康予纳安" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main class="content-container">
      <slot />
    </main>

    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --primary-color: #2563eb;
    --text-color: #1f2937;
    --bg-color: #f8fafc;
  }
  
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-main);
    background-color: var(--bg-color);
    color: var(--text-color);
    -webkit-font-smoothing: antialiased;
    line-height: 1.7;
  }

  /* 居中容器，让阅读更有美感 */
  .content-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  /* 标题美化 */
  h1, h2, h3 {
    color: #111827;
    margin-top: 1.8em;
    margin-bottom: 0.6em;
    font-weight: 700;
  }

  /* 数学公式视觉增强 */
  .katex-display {
    margin: 1.8em 0 !important;
    padding: 1.2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    overflow-x: auto;
    text-align: center;
  }

  /* 🛡️ 核心修复：防止公式重复渲染的强力补丁 */
  .katex-display + .katex-display, 
  .katex + .katex {
    display: none !important;
  }

  /* 引用块（用于 Tips 或 定理） */
  blockquote {
    border-left: 4px solid var(--primary-color);
    background: #eff6ff;
    padding: 1.2rem;
    margin: 1.5rem 0;
    border-radius: 0 8px 8px 0;
    font-style: normal;
  }

  /* 分割线 */
  hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }
</style>