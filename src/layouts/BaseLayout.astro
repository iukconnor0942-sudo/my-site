---
import { getCollection } from 'astro:content';

// 🔥 自动获取 changelog 最新日期
const allChangelogs = await getCollection('changelog');
const latestChangelog = allChangelogs
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))[0];
const latestDate = latestChangelog ? latestChangelog.data.date : '2026-04-10';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{Astro.props.title || "康予纳安"}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="page-wrapper">
      <main class="super-wide-layout">
        <slot />
      </main>
    </div>
    <Analytics />
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background-color: #F2F4F6;
    width: 100%;
    overflow-x: hidden;
  }

  /* 🚀 页面外层包装 - 实现左右天蓝边 */
  .page-wrapper {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(to right, 
      #E8F5FC 0%, 
      #E8F5FC 4%, 
      transparent 4%, 
      transparent 96%, 
      #E8F5FC 96%, 
      #E8F5FC 100%);
  }

  .super-wide-layout {
    width: 100%;
    max-width: 1280px;           /* 内容最大宽度，调大一点更舒服 */
    margin: 0 auto;
    min-height: 100vh;
    background: white;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 1;
  }

  /* 导航栏、hero 等主要区域保持居中 */
  nav, .hero, .content-section, .tags-strip, .footer {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 5%;
    padding-right: 5%;
  }

  @media (min-width: 1200px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  /* 手机端更紧凑 */
  @media (max-width: 768px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 16px;
      padding-right: 16px;
    }
    .super-wide-layout {
      max-width: 100%;
    }
  }

  /* 恢复你原来的颜色和样式 */
  .hero {
    background-image: url('/images/hero-bg.png') !important;
    background-size: cover;
    background-position: center 30%;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.65);
    z-index: 0;
  }

  .camellya-block {
    background: var(--surface);
    border: 0.5px solid var(--border);
  }
  .cam-header {
    background: var(--blue-light);
  }

  /* 其他你原来的样式保持不变 */
  .nav { background: var(--surface); display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 0.5px solid var(--border); flex-wrap: wrap; gap: 10px; }
  .nav-logo { font-size: 15px; font-weight: 500; color: var(--text); }
  .nav-links { display: flex; gap: 16px; flex-wrap: wrap; }
  .nav-links a { font-size: 13px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .nav-links a:hover { color: var(--blue); }
  .nav-accent { color: var(--red) !important; font-weight: 500; }

  .new-badge {
    position: absolute;
    top: -6px;
    right: -11px;
    background: var(--red);
    color: white;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 20px;
    animation: badge-pulse 2s infinite;
    display: none;
  }

  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  /* 其他你需要的样式可以继续加在这里…… */
</style>

<script>
  // NEW 红点逻辑保持不变
  const badge = document.getElementById('new-badge');
  const link = document.getElementById('updates-link');
  const lastUpdateDate = badge ? badge.dataset.lastDate : '2026-04-10';
  const lastSeen = localStorage.getItem('lastSeenChangelog');

  if (badge && (!lastSeen || lastSeen < lastUpdateDate)) {
    badge.style.display = 'inline';
  }
  if (link) {
    link.addEventListener('click', () => {
      localStorage.setItem('lastSeenChangelog', lastUpdateDate);
      if (badge) badge.style.display = 'none';
    });
  }
</script>