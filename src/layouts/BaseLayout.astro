---
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro'; // ← 必须保留这行！

const { title = "康予纳安" } = Astro.props;

// 🔥 自动获取 changelog 最新日期
const allChangelogs = await getCollection('changelog');
const latestChangelog = allChangelogs
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))[0];
const latestDate = latestChangelog ? latestChangelog.data.date : '2026-04-10';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
    <!-- 🔥 新增：KaTeX JS 文件（必须加） -->
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" defer></script>
  </head>
  <body>
    <div class="page-wrapper">
      <main class="super-wide-layout">
        <slot />
      </main>
    </div>
    <Analytics /> <!-- ← 这里必须保留 -->
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background-color: #F2F4F6;
    width: 100%;
    overflow-x: hidden;
  }
  /* 左右天蓝装饰边 */
  .page-wrapper {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(to right,
      #E8F5FC 0%,
      #E8F5FC 4%,
      transparent 4%,
      transparent 96%,
      #E8F5FC 96%,
      #E8F5FC 100%);
  }
  .super-wide-layout {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 100vh;
    background: white;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 1;
  }
  /* 主要内容区居中 */
  nav, .hero, .content-section, .tags-strip, .footer {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 5%;
    padding-right: 5%;
  }
  @media (min-width: 1200px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 40px;
      padding-right: 40px;
    }
  }
  @media (max-width: 768px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 16px;
      padding-right: 16px;
    }
    .super-wide-layout {
      max-width: 100%;
    }
  }
  /* 恢复原来的颜色和背景 */
  .hero {
    background-image: url('/images/hero-bg.png') !important;
    background-size: cover;
    background-position: center 30%;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.65);
    z-index: 0;
  }
  .camellya-block { background: white; border: 0.5px solid #e0e4ea; }
  .cam-header { background: #E8F5FC; }
  /* 导航栏样式 */
  .nav {
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 0.5px solid #e0e4ea;
    flex-wrap: wrap;
    gap: 10px;
  }
  .nav-logo { font-size: 15px; font-weight: 500; color: #1a1a1a; }
  .nav-links { display: flex; gap: 16px; flex-wrap: wrap; }
  .nav-links a { font-size: 13px; color: #666; text-decoration: none; white-space: nowrap; }
  .nav-links a:hover { color: #4AACDB; }
  .nav-accent { color: #C94040 !important; font-weight: 500; }
  .nav-updates { position: relative; color: #666; text-decoration: none; font-size: 13px; padding-right: 4px; }
  .nav-updates:hover { color: #4AACDB; }
  .new-badge {
    position: absolute;
    top: -6px;
    right: -11px;
    background: #C94040;
    color: white;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 20px;
    animation: badge-pulse 2s infinite;
    display: none;
  }
  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
</style>

<script>
  // NEW 红点逻辑
  const badge = document.getElementById('new-badge');
  const link = document.getElementById('updates-link');
  const lastUpdateDate = badge ? badge.dataset.lastDate : '2026-04-10';
  const lastSeen = localStorage.getItem('lastSeenChangelog');
  if (badge && (!lastSeen || lastSeen < lastUpdateDate)) {
    badge.style.display = 'inline';
  }
  if (link) {
    link.addEventListener('click', () => {
      localStorage.setItem('lastSeenChangelog', lastUpdateDate);
      if (badge) badge.style.display = 'none';
    });
  }

  // 🔥 KaTeX 自动渲染（全局生效）
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof renderMathInElement !== 'undefined') {
      renderMathInElement(document.body, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
          { left: '\\(', right: '\\)', display: false },
          { left: '\\[', right: '\\]', display: true }
        ],
        throwOnError: false
      });
    }
  });
</script>