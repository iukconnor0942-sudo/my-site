---
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro';

const { title = "康予纳安" } = Astro.props;

const allChangelogs = await getCollection('changelog');
const latestChangelog = allChangelogs
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))[0];
const latestDate = latestChangelog ? latestChangelog.data.date : '2026-04-10';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" defer></script>
  </head>
  <body>

    <div id="loader" aria-hidden="true">
      <div class="ld-grid"></div>
      <div class="ld-scan"></div>
      <div class="ld-panel">
        <span class="ldc tl"></span>
        <span class="ldc tr"></span>
        <span class="ldc bl"></span>
        <span class="ldc br"></span>
        <div class="ld-logo">
          <span class="ld-arrow">▶</span>
          <span class="ld-brand">康予纳安</span>
        </div>
        <div class="ld-sys" id="ld-sys">SYSTEM_INITIALIZING...</div>
        <div class="ld-bar-track">
          <div class="ld-bar" id="ld-bar"></div>
          <div class="ld-bar-glow" id="ld-bar-glow"></div>
        </div>
        <div class="ld-meta">
          <span class="ld-meta-item">SYS_BOOT</span>
          <span class="ld-meta-dot">·</span>
          <span class="ld-meta-item">LV.999</span>
          <span class="ld-meta-dot">·</span>
          <span class="ld-meta-item" id="ld-pct">0%</span>
        </div>
      </div>
      <div class="ld-sweep" id="ld-sweep"></div>
    </div>

    <div class="page-wrapper">
      <main class="layout-center">
        <slot />
      </main>
    </div>

    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    --bg: #080b14; --surface: #0d1020; --surface-2: #131a2e;
    --purple: #7B5EFF; --purple-light: rgba(123,94,255,0.1); --purple-border: rgba(123,94,255,0.28);
    --cyan: #4DDFFF; --cyan-light: rgba(77,223,255,0.07); --cyan-border: rgba(77,223,255,0.25);
    --red: #FF4D8F; --red-light: rgba(255,77,143,0.08); --red-border: rgba(255,77,143,0.28);
    --text: #E8EAFF; --muted: #8B8FA8; --hint: #4a4e6a; --border: rgba(123,94,255,0.15);
    --font-main: 'LXGW WenKai', 'PingFang SC', sans-serif;
    --font-mono: 'Share Tech Mono', 'Courier New', monospace;
  }

  html, body {
    margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: var(--font-main); line-height: 1.7;
    width: 100%; overflow-x: hidden; -webkit-tap-highlight-color: transparent;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  a { color: inherit; text-decoration: none; }
  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--purple-border); border-radius: 2px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--purple); }

  .page-wrapper { position: relative; min-height: 100vh; width: 100%; background: var(--bg); }
  .layout-center {
    width: 100%; max-width: 1280px; margin: 0 auto; min-height: 100vh;
    background: var(--surface); position: relative; z-index: 1;
    border-left: 1px solid var(--border); border-right: 1px solid var(--border);
  }
  @media (max-width: 768px) { .layout-center { border-left: none; border-right: none; } }

  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  @keyframes pulse-glow {
    0%,100% { box-shadow: 0 0 4px currentColor; }
    50% { box-shadow: 0 0 14px currentColor, 0 0 28px currentColor; }
  }

  /* ── LOADER ── */
  #loader {
    position: fixed; inset: 0; background: #080b14; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; transition: opacity 0.5s ease;
  }
  #loader.hidden { display: none; }
  #loader.out { opacity: 0; pointer-events: none; }

  .ld-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(123,94,255,0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123,94,255,0.055) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .ld-scan {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      0deg, transparent, transparent 3px, rgba(0,0,0,0.09) 3px, rgba(0,0,0,0.09) 4px
    );
    pointer-events: none;
  }
  .ld-sweep {
    position: absolute; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg,
      transparent 0%, rgba(77,223,255,0.0) 10%,
      rgba(77,223,255,0.6) 50%, rgba(77,223,255,0.0) 90%, transparent 100%
    );
    top: -2px; animation: sweep 2s linear 0.1s forwards;
  }
  @keyframes sweep { 0%{ top:-2px; opacity:0.8; } 90%{ opacity:0.6; } 100%{ top:100%; opacity:0; } }

  .ld-panel {
    position: relative; display: flex; flex-direction: column;
    align-items: center; gap: 18px; padding: 52px 72px;
    border: 1px solid rgba(123,94,255,0.22); min-width: 340px;
    animation: panel-in 0.5s cubic-bezier(0.16,1,0.3,1) 0.05s both;
  }
  @keyframes panel-in {
    from { opacity:0; transform: scale(0.96) translateY(8px); }
    to   { opacity:1; transform: scale(1) translateY(0); }
  }

  .ldc { position: absolute; width: 14px; height: 14px; pointer-events: none; }
  .ldc.tl { top:-1px; left:-1px;   border-top:2px solid #4DDFFF; border-left:2px solid #4DDFFF; }
  .ldc.tr { top:-1px; right:-1px;  border-top:2px solid #4DDFFF; border-right:2px solid #4DDFFF; }
  .ldc.bl { bottom:-1px; left:-1px;  border-bottom:2px solid #4DDFFF; border-left:2px solid #4DDFFF; }
  .ldc.br { bottom:-1px; right:-1px; border-bottom:2px solid #4DDFFF; border-right:2px solid #4DDFFF; }

  .ld-logo { display: flex; align-items: center; gap: 10px; animation: fade-up 0.5s ease 0.3s both; }
  .ld-arrow { font-family: var(--font-mono); font-size: 12px; color: #4DDFFF; animation: blink 1s step-end infinite; }
  .ld-brand { font-family: var(--font-mono); font-size: 30px; font-weight: 600; color: #E8EAFF; letter-spacing: 0.12em; }

  .ld-sys {
    font-family: var(--font-mono); font-size: 11px; color: #4DDFFF;
    letter-spacing: 0.18em; animation: fade-up 0.4s ease 0.55s both;
    min-height: 1.4em; transition: opacity 0.3s, color 0.3s;
  }
  .ld-bar-track {
    width: 240px; height: 3px; background: rgba(123,94,255,0.18);
    border-radius: 2px; overflow: visible; position: relative;
    animation: fade-up 0.4s ease 0.65s both;
  }
  .ld-bar {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #7B5EFF 0%, #4DDFFF 100%);
    border-radius: 2px; transition: width 0.05s linear;
  }
  .ld-bar-glow {
    position: absolute; top: -3px; bottom: -3px; left: -6px;
    width: 12px; background: #4DDFFF; border-radius: 50%;
    filter: blur(4px); opacity: 0.7; pointer-events: none;
    transition: left 0.05s linear;
  }
  .ld-meta { display: flex; align-items: center; gap: 8px; animation: fade-up 0.4s ease 0.8s both; }
  .ld-meta-item { font-family: var(--font-mono); font-size: 10px; color: rgba(139,143,168,0.55); letter-spacing: 0.12em; }
  .ld-meta-dot { color: rgba(139,143,168,0.3); font-size: 12px; }

  @keyframes fade-up { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:translateY(0); } }

  @keyframes glitch-out {
    0%   { transform:translate(0); filter:none; }
    20%  { transform:translate(-3px,1px); filter:hue-rotate(60deg) brightness(1.4); }
    40%  { transform:translate(3px,-1px); filter:hue-rotate(-60deg); }
    60%  { transform:translate(-2px,2px); filter:brightness(2); }
    80%  { transform:translate(2px,-2px); filter:hue-rotate(90deg); }
    100% { transform:translate(0); filter:none; }
  }
  #loader.glitch .ld-panel { animation: glitch-out 0.18s steps(1) forwards; }
</style>

<script>
  /* ── LOADER：同一 session 只播一次 ── */
  (function () {
    const loader  = document.getElementById('loader');
    const bar     = document.getElementById('ld-bar');
    const barGlow = document.getElementById('ld-bar-glow');
    const sys     = document.getElementById('ld-sys');
    const pct     = document.getElementById('ld-pct');

    if (!loader) return;

    // 已经播过了，直接隐藏，不再播
    if (sessionStorage.getItem('loaderPlayed')) {
      loader.classList.add('hidden');
      return;
    }

    if (!bar) return;

    const duration = 1500;
    const start = performance.now();

    function ease(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function step(now) {
      const elapsed = now - start;
      const raw = Math.min(elapsed / duration, 1);
      const progress = ease(raw);
      const percent = Math.round(progress * 100);

      bar.style.width = percent + '%';
      if (pct) pct.textContent = percent + '%';
      if (barGlow) barGlow.style.left = 'calc(' + percent + '% - 6px)';

      if (raw < 1) {
        requestAnimationFrame(step);
      } else {
        if (sys) {
          sys.style.opacity = '0';
          setTimeout(() => {
            sys.textContent = 'ACCESS_GRANTED';
            sys.style.color = '#7B5EFF';
            sys.style.opacity = '1';
          }, 200);
        }
        setTimeout(() => {
          loader.classList.add('glitch');
          setTimeout(() => {
            loader.classList.add('out');
            // 记录已播放
            sessionStorage.setItem('loaderPlayed', '1');
            setTimeout(() => loader.remove(), 520);
          }, 200);
        }, 520);
      }
    }

    setTimeout(() => requestAnimationFrame(step), 100);
  })();

  /* ── CHANGELOG BADGE ── */
  const badge = document.getElementById('new-badge');
  const link  = document.getElementById('updates-link');
  const lastUpdateDate = badge ? badge.dataset.lastDate : '2026-04-10';
  const lastSeen = localStorage.getItem('lastSeenChangelog');
  if (badge && (!lastSeen || lastSeen < lastUpdateDate)) {
    badge.style.display = 'inline';
  }
  link?.addEventListener('click', () => {
    localStorage.setItem('lastSeenChangelog', lastUpdateDate);
    if (badge) badge.style.display = 'none';
  });

  /* ── KATEX ── */
  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(() => {
      if (typeof renderMathInElement !== 'undefined') {
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$',  right: '$',  display: false }
          ],
          throwOnError: false
        });
      }
    }, 100);
  });
</script>