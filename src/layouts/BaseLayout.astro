---
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro';

const { title = "康予纳安" } = Astro.props;

const allChangelogs = await getCollection('changelog');
const latestChangelog = allChangelogs
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))[0];
const latestDate = latestChangelog ? latestChangelog.data.date : '2026-04-10';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" defer></script>
  </head>
  <body>
    <div class="page-wrapper">
      <main class="super-wide-layout">
        <slot />
      </main>
    </div>
    <Analytics />
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background-color: #F2F4F6;
    width: 100%;
    overflow-x: hidden;
    /* 解决移动端点击高亮问题 */
    -webkit-tap-highlight-color: transparent;
  }

  /* 💎 核心优化：装饰边逻辑分层 */
  .page-wrapper {
    position: relative;
    min-height: 100vh;
    width: 100%;
  }

  @media (min-width: 1024px) {
    /* 仅在桌面端显示左右天蓝装饰边 */
    .page-wrapper {
      background: linear-gradient(to right,
        #E8F5FC 0%,
        #E8F5FC 4%,
        transparent 4%,
        transparent 96%,
        #E8F5FC 96%,
        #E8F5FC 100%);
    }
  }

  .super-wide-layout {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 100vh;
    background: white;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 1;
  }

  /* 导航与内容区适配 */
  nav, .hero, .content-section, .tags-strip, .footer {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box; /* 确保 padding 不撑开宽度 */
  }

  /* 桌面端大间距 */
  @media (min-width: 1024px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  /* 📱 移动端深度优化 */
  @media (max-width: 768px) {
    nav, .hero, .content-section, .tags-strip, .footer {
      padding-left: 20px;
      padding-right: 20px;
    }
    .super-wide-layout {
      box-shadow: none; /* 移动端去掉阴影省资源且更清爽 */
    }
    /* 导航栏在手机端微调 */
    .nav {
      padding: 12px 16px !important;
    }
    .nav-links {
      gap: 12px !important;
    }
  }

  /* 恢复 Hero 背景 */
  .hero {
    background-image: url('/images/hero-bg.png') !important;
    background-size: cover;
    background-position: center 30%;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.65);
    z-index: 0;
  }

  /* 其他原有样式保持不变 */
  .camellya-block { background: white; border: 0.5px solid #e0e4ea; }
  .cam-header { background: #E8F5FC; }
  
  .nav {
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 0.5px solid #e0e4ea;
    flex-wrap: wrap;
    gap: 10px;
  }
  .nav-logo { font-size: 15px; font-weight: 600; color: #1a1a1a; }
  .nav-links { display: flex; gap: 16px; flex-wrap: wrap; }
  .nav-links a { font-size: 13px; color: #666; text-decoration: none; white-space: nowrap; }
  .nav-links a:hover { color: #4AACDB; }
  .nav-accent { color: #C94040 !important; font-weight: 500; }
  
  .new-badge {
    background: #C94040;
    color: white;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 20px;
    display: none;
  }
</style>

<script>
  // 保持原有逻辑不变
  const badge = document.getElementById('new-badge');
  const link = document.getElementById('updates-link');
  const lastUpdateDate = badge ? badge.dataset.lastDate : '2026-04-10';
  const lastSeen = localStorage.getItem('lastSeenChangelog');
  if (badge && (!lastSeen || lastSeen < lastUpdateDate)) {
    badge.style.display = 'inline';
  }

  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(() => {
      if (typeof renderMathInElement !== 'undefined') {
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false }
          ],
          throwOnError: false
        });
      }
    }, 100);
  });
</script>