---
// 1. 修复导入方式
import Analytics from '@vercel/analytics/astro';

// 接收来自页面的 props
const { title = "康予纳安" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main class="desktop-fluid-layout">
      <slot />
    </main>

    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --primary-color: #2563eb;
  }
  
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-main);
    background-color: #F2F4F6;
    color: #1a1a1a;
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* 🚀 桌面端铺满逻辑修复 */
  .desktop-fluid-layout {
    width: 100%;           /* 宽度强制 100% */
    max-width: 100%;       /* 移除任何 max-width 限制 */
    margin: 0;             /* 移除水平居中的 auto 边距 */
    padding: 3rem 4%;      /* 仅保留 4% 的呼吸空隙，让内容最大化利用屏幕 */
    background: transparent;
  }

  /* 优化：在大屏下，标题和正文会自动调整大小 */
  h1 { font-size: 2.5rem; margin-bottom: 1rem; }
  h2 { font-size: 1.8rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.3em; }

  /* 公式渲染：在大屏幕下更显大气 */
  .katex-display {
    margin: 2rem 0 !important;
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    /* 允许长公式在超大屏上也能完美展示 */
    overflow-x: auto;
  }

  .katex {
    font-size: 1.15em; 
  }

  /* 引用块样式优化 */
  blockquote {
    border-left: 5px solid var(--primary-color);
    background: #eff6ff;
    padding: 1.5rem 2rem;
    margin: 2rem 0;
    border-radius: 0 12px 12px 0;
  }

  /* 适配移动端：如果用手机看，会自动收缩回来 */
  @media (max-width: 768px) {
    .desktop-fluid-layout {
      padding: 2rem 1rem;
    }
  }
</style>