---
// 1. 修复导入方式
import Analytics from '@vercel/analytics/astro';

// 接收来自页面的 props
const { title = "康予纳安" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8M5bezhhgVSIdW6A7wGNF7fCqnH076xe21qL2TwH6ux9nbp0i67Ywc67Nf3"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <main class="super-wide-layout">
      <slot />
    </main>

    <Analytics />
  </body>
</html>

<style is:global>
  /* 强制覆盖所有可能的限制 */
  html, body {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #F2F4F6;
  }

  .super-wide-layout {
    /* 🚀 核心：强制撑开到屏幕两端 */
    width: 100vw !important; 
    max-width: 100vw !important;
    min-height: 100vh;
    
    /* 留一点点边距（3%）是为了美感，不想要的话可以改回 0 */
    padding: 4rem 4% !important; 
    
    margin: 0 !important;
    box-sizing: border-box;
    display: block;
  }

  /* 针对公式的桌面端优化 */
  .katex-display {
    width: 100% !important;
    margin: 2rem 0 !important;
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  /* 增强可读性 */
  h1 { font-size: 2.8rem; }
  h2 { font-size: 2.2rem; margin-top: 2em; border-bottom: 2px solid #cbd5e1; }
  p, li { font-size: 1.15rem; line-height: 1.8; }

  /* 彻底消除重复渲染的残留 */
  .katex-display + .katex-display { display: none !important; }

</style>